async def show_leaders(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p: await call.answer("Сначала /start", show_alert=True); return
    await _render_leaders(call, "level")

@router.callback_query(F.data.startswith("leaders:show:"))
