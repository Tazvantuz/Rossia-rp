def _scale_mob(name, emoji, level, is_boss=False):
    if is_boss:
        hp  = int((30 + level * level * 0.7) * 5)
        atk = int((5 + level * 3.5) * 2)
        dfn = int((1 + level * 1.0) * 3)
        spd = int(4 + level * 0.2)
        xp  = int((15 + level * 15) * 5)
        gold_range = (level * 50, level * 150)
    else:
        hp  = int(30 + level * level * 0.7)
        atk = int(5 + level * 3.5)
        dfn = int(1 + level * 1.0)
        spd = int(4 + level * 0.2)
        xp  = int(15 + level * 15)
        gold_range = (max(5, level * 10), max(20, level * 30))
    return {
        "name": name, "emoji": emoji, "level": level,
        "hp": hp, "max_hp": hp, "atk": atk, "def": dfn, "spd": spd,
        "xp": xp, "gold_range": gold_range, "is_boss": is_boss,
    }

# ══════════════════════════════════════════════════════════════
#  БОССЫ — дроп таблицы
# ══════════════════════════════════════════════════════════════
def _boss_drops(tier):
    """Типичные дропы для босса — рандомные предметы тира."""
    drops = [
        (f"potion_hp_{min(4, tier)}", 0.8),
        (f"potion_mp_{min(4, tier)}", 0.8),
        (f"potion_hp_{min(4, tier+1)}", 0.4),
        ("potion_hp_4", 0.15),
    ]
    # Добавляем классовые предметы следующего тира
    next_tier = min(5, tier + 1)
    for cls in CLASSES:
        drops.append((f"w_{cls}_{next_tier}", 0.10))
        drops.append((f"a_{cls}_{next_tier}", 0.10))
    return drops

BOSSES = {
    7:  {"name": "Крысиный король",     "emoji": "👑", "level": 10},
    15: {"name": "Горный тролль",       "emoji": "🧌", "level": 20},
    23: {"name": "Лич-Повелитель",      "emoji": "💀", "level": 30},
    31: {"name": "Древний Дракон",      "emoji": "🐉", "level": 40},
}

def get_boss_for_location(lid):
    data = BOSSES[lid]
    mob = _scale_mob(data["name"], data["emoji"], data["level"], is_boss=True)
    mob["drops"] = _boss_drops(LOCATIONS[lid]["tier"])
    return mob

def get_mobs_for_location(lid):
    loc = LOCATIONS[lid]
    if loc["safe"]: return []
    if loc["boss"]: return [get_boss_for_location(lid)]
    theme = ROW_THEMES[loc["y"]]
    variants = theme["mobs"]
    level_base = theme["level_base"]
    start = (loc["x"] * 3) % len(variants)
    result = []
    for i in range(3):
        name, emoji = variants[(start + i) % len(variants)]
        level = level_base + i * 2
        mob = _scale_mob(name, emoji, level)
        mob["drops"] = [
            (f"potion_hp_{min(4, max(1, level // 10 + 1))}", 0.15),
            (f"potion_mp_{min(4, max(1, level // 10 + 1))}", 0.15),
            (f"w_{random.choice(list(CLASSES))}_{min(5, max(1, level // 10 + 1))}", 0.03),
            (f"a_{random.choice(list(CLASSES))}_{min(5, max(1, level // 10 + 1))}", 0.03),
        ]
        result.append(mob)
    return result

# ══════════════════════════════════════════════════════════════
#  ПРОКАЧКА
# ══════════════════════════════════════════════════════════════
def xp_to_next(level):
    return round(80 * level ** 1.6)

def xp_from_pvp(level):
    return 10 + level * 5

def check_level_up(player):
    cls = CLASSES[player["class_id"]]
    gained = 0
    while player["level"] < MAX_LEVEL:
        need = xp_to_next(player["level"])
        if player["xp"] < need: break
        player["xp"] -= need
        player["level"] += 1
        d_hp, d_mp = cls["hp_g"], cls["mp_g"]
        d_atk, d_def = cls["atk_g"], cls["def_g"]
        d_spd, d_crit = cls["spd_g"], cls["crit_g"]
        if "_base_atk" in player:
            player["_base_atk"] += d_atk
            player["_base_def"] += d_def
            player["_base_spd"] += d_spd
            player["_base_crit"] = round(player["_base_crit"] + d_crit, 2)
            player["_base_max_hp"] += d_hp
            player["_base_max_mp"] += d_mp
        player["atk"] += d_atk; player["def"] += d_def
        player["spd"] += d_spd; player["crit"] = round(player["crit"] + d_crit, 2)
        player["max_hp"] += d_hp; player["max_mp"] += d_mp
        player["stat_points"] = player.get("stat_points", 0) + STAT_POINTS_PER_LEVEL
        player["hp"] = player["max_hp"]; player["mp"] = player["max_mp"]
        gained += 1
    if player["level"] >= MAX_LEVEL: player["xp"] = 0
    return gained

# ══════════════════════════════════════════════════════════════
#  БД
# ══════════════════════════════════════════════════════════════
SCHEMA = """
CREATE TABLE IF NOT EXISTS players (
    user_id INTEGER PRIMARY KEY, nickname TEXT UNIQUE NOT NULL,
    class_id TEXT NOT NULL, level INTEGER DEFAULT 1, xp INTEGER DEFAULT 0,
    hp INTEGER NOT NULL, max_hp INTEGER NOT NULL, mp INTEGER NOT NULL, max_mp INTEGER NOT NULL,
    atk INTEGER NOT NULL, def INTEGER NOT NULL, spd INTEGER NOT NULL, crit REAL NOT NULL,
    gold INTEGER DEFAULT 50, location_id INTEGER DEFAULT 0,
    weapon_id TEXT, armor_id TEXT, shield_id TEXT,
    stat_points INTEGER DEFAULT 0, created_at TEXT DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS inventory (
    id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL,
    item_id TEXT NOT NULL, quantity INTEGER DEFAULT 1, UNIQUE(user_id, item_id)
);
CREATE TABLE IF NOT EXISTS parties (
    party_id INTEGER PRIMARY KEY AUTOINCREMENT, leader_id INTEGER NOT NULL UNIQUE,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS party_members (
    party_id INTEGER NOT NULL, user_id INTEGER NOT NULL UNIQUE,
    PRIMARY KEY(party_id, user_id)
);
"""

class Database:
    def __init__(self, path=DB_PATH):
        self.path = path; self.conn = None
    async def init(self):
        self.conn = await aiosqlite.connect(self.path)
        self.conn.row_factory = aiosqlite.Row
        await self.conn.executescript(SCHEMA); await self.conn.commit()
        for col, defn in [("stat_points", "INTEGER DEFAULT 0")]:
            try:
                await self.conn.execute(f"ALTER TABLE players ADD COLUMN {col} {defn}")
                await self.conn.commit()
            except: pass
    async def fetchone(self, q, p=()):
        async with self.conn.execute(q, p) as cur:
            r = await cur.fetchone()
            return dict(r) if r else None
    async def fetchall(self, q, p=()):
        async with self.conn.execute(q, p) as cur:
            return [dict(r) for r in await cur.fetchall()]
    async def execute(self, q, p=()):
        async with self.conn.execute(q, p) as cur:
            await self.conn.commit(); return cur.lastrowid
    async def close(self):
        if self.conn: await self.conn.close()

db = Database()

# ══════════════════════════════════════════════════════════════
#  ХЕЛПЕРЫ
# ══════════════════════════════════════════════════════════════
def hp_bar(cur, mx, length=10):
    if mx <= 0: mx = 1
    f = max(0, min(length, int(round(cur / mx * length))))
    return "█" * f + "░" * (length - f)

def get_effective_stats(player):
    stats = {"atk": player["atk"], "def": player["def"], "spd": player["spd"],
             "crit": player["crit"], "max_hp": player["max_hp"], "max_mp": player["max_mp"]}
    for slot in ("weapon_id", "armor_id", "shield_id"):
        iid = player.get(slot)
        if not iid: continue
        item = ITEMS.get(iid)
        if not item: continue
        stats["atk"]    += item.get("atk", 0)
        stats["def"]    += item.get("def", 0)
        stats["spd"]    += item.get("spd", 0)
        stats["max_hp"] += item.get("hp", 0)
        stats["max_mp"] += item.get("mp", 0)
        stats["crit"]   += item.get("crit", 0)
    return stats

def apply_equipment_to_player_copy(player):
    p = dict(player)
    p["_base_atk"] = player["atk"]; p["_base_def"] = player["def"]
    p["_base_spd"] = player["spd"]; p["_base_crit"] = player["crit"]
    p["_base_max_hp"] = player["max_hp"]; p["_base_max_mp"] = player["max_mp"]
    eff = get_effective_stats(player)
    p["atk"] = eff["atk"]; p["def"] = eff["def"]
    p["spd"] = eff["spd"]; p["crit"] = round(eff["crit"], 2)
    p["max_hp"] = eff["max_hp"]; p["max_mp"] = eff["max_mp"]
    p["hp"] = min(p["hp"], eff["max_hp"]); p["mp"] = min(p["mp"], eff["max_mp"])
    return p

async def get_player(uid):
    return await db.fetchone("SELECT * FROM players WHERE user_id = ?", (uid,))

async def add_inventory(uid, iid, qty=1):
    await db.execute(
        "INSERT INTO inventory (user_id, item_id, quantity) VALUES (?, ?, ?) "
        "ON CONFLICT(user_id, item_id) DO UPDATE SET quantity = quantity + excluded.quantity",
        (uid, iid, qty))

async def safe_edit(call, text, kb=None):
    chat = call.message.chat
    if chat.type == "private":
        try:
            await call.message.edit_text(text, reply_markup=kb, parse_mode="HTML"); return
        except: pass
        try: await call.message.answer(text, reply_markup=kb, parse_mode="HTML")
        except: pass
        return
    owner = MESSAGE_OWNER.get(call.message.message_id)
    if owner is not None and owner != call.from_user.id:
        try: await call.answer("Это меню другого игрока.\nОтправь /menu.", show_alert=True)
        except: pass
        return
    try: await call.message.delete()
    except: pass
    try:
        sent = await call.bot.send_message(chat.id, text, reply_markup=kb, parse_mode="HTML")
        MESSAGE_OWNER[sent.message_id] = call.from_user.id
    except Exception as e:
        logging.warning(f"group send: {e}")

async def send_to(message, text, kb=None, force_reply=False):
    kwargs = {"parse_mode": "HTML"}
    if force_reply: kwargs["reply_markup"] = ForceReply()
    elif kb: kwargs["reply_markup"] = kb
    if message.chat.type != "private":
        kwargs["reply_to_message_id"] = message.message_id
        kwargs["allow_sending_without_reply"] = True
    try:
        sent = await message.answer(text, **kwargs)
        if message.chat.type != "private":
            MESSAGE_OWNER[sent.message_id] = message.from_user.id
        return sent
    except Exception as e:
        logging.warning(f"send_to: {e}")

