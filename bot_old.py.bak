                    back_to_main())

# ══════════════════════════════════════════════════════════════
#  БОЙ PvE — с боссами и дропом
# ══════════════════════════════════════════════════════════════
def battle_text(state):
    p, m = state["player"], state["mob"]
    c = CLASSES[p["class_id"]]
    prefix = "💀 <b>БОСС</b>\n" if m.get("is_boss") else ""
    return (f"{prefix}⚔️ <b>Бой</b> · {c['emoji']} {p['nickname']} vs {m['emoji']} {m['name']}\n\n"
            f"<b>{p['nickname']}</b>\n"
            f"❤️ {hp_bar(p['hp'], p['max_hp'])} {p['hp']}/{p['max_hp']}\n"
            f"💧 {hp_bar(p['mp'], p['max_mp'])} {p['mp']}/{p['max_mp']}\n"
            f"⚔️ {p['atk']} · 🛡️ {p['def']} · 💨 {p['spd']}\n\n"
            f"<b>{m['emoji']} {m['name']}</b> (ур. {m['level']})\n"
            f"❤️ {hp_bar(m['hp'], m['max_hp'])} {m['hp']}/{m['max_hp']}\n"
            f"⚔️ {m['atk']} · 🛡️ {m['def']} · 💨 {m['spd']}\n\n"
            f"{state.get('last_log','')}")

@router.callback_query(F.data == "menu:battle")
async def menu_battle(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p: await call.answer("Сначала /start", show_alert=True); return
    if call.from_user.id in ACTIVE_BATTLES:
        st = ACTIVE_BATTLES[call.from_user.id]
        await safe_edit(call, battle_text(st), battle_kb(st["player"])); return
    if call.from_user.id in USER_PVP_KEY or call.from_user.id in USER_PARTY_BATTLE:
        await call.answer("Ты в другом бою!", show_alert=True); return
    loc = LOCATIONS[p["location_id"]]
    if loc["safe"]:
        await safe_edit(call,
            f"🏰 <b>{loc['name']}</b>\n\nВ городах сражения запрещены.",
            back_to_main()); return
    mobs = get_mobs_for_location(p["location_id"])
    rows = []
    for i, m in enumerate(mobs):
        prefix = "💀 " if m.get("is_boss") else ""
        rows.append([InlineKeyboardButton(
            text=f"{prefix}{m['emoji']} {m['name']} · ур.{m['level']} · HP {m['max_hp']} · DEF {m['def']}",
            callback_data=f"battle:start:{i}")])
    rows.append([InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")])
    title = "💀 <b>Логово босса</b>" if loc["boss"] else f"⚔️ <b>Охота в {loc['name']}</b>"
    await safe_edit(call, f"{title}\n\nВыбери противника:",
                    InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("battle:start:"))
async def battle_start(call: CallbackQuery):
    if call.from_user.id in ACTIVE_BATTLES:
        await call.answer("Ты уже в бою!"); return
    if call.from_user.id in USER_PVP_KEY or call.from_user.id in USER_PARTY_BATTLE:
        await call.answer("Ты в другом бою!"); return
    p = await get_player(call.from_user.id)
    idx = int(call.data.split(":")[2])
    mobs = get_mobs_for_location(p["location_id"])
    if idx >= len(mobs):
        await call.answer("Ошибка"); return
    p_eff = apply_equipment_to_player_copy(p)
    ACTIVE_BATTLES[call.from_user.id] = {
        "player": p_eff, "mob": dict(mobs[idx]), "last_log": "Бой начался!",
    }
    await safe_edit(call, battle_text(ACTIVE_BATTLES[call.from_user.id]),
                    battle_kb(p_eff))

async def _mob_turn(state, log):
    p, m = state["player"], state["mob"]
    crit = random.random() * 100 < 5
    dmg = max(1, m["atk"] - p["def"] // 2 + random.randint(-2, 3))
    if crit: dmg *= 2
    p["hp"] -= dmg
    log.append(f"👹 {m['name']} наносит <b>{dmg}</b>" + (" 💥 <b>КРИТ!</b>" if crit else ""))

@router.callback_query(F.data == "battle:attack")
async def battle_attack(call: CallbackQuery):
    state = ACTIVE_BATTLES.get(call.from_user.id)
    if not state: await call.answer("Бой не найден"); return
    p, m = state["player"], state["mob"]
    log = []
    crit = random.random() * 100 < p["crit"]
    dmg = max(1, p["atk"] - m["def"] // 2 + random.randint(-2, 4))
    if crit: dmg *= 2
    m["hp"] -= dmg
    log.append(f"⚔️ Ты наносишь <b>{dmg}</b>" + (" 💥 <b>КРИТ!</b>" if crit else ""))
    if m["hp"] <= 0:
        m["hp"] = 0
        await _victory(call, state, log); return
    await _mob_turn(state, log)
    if p["hp"] <= 0:
        p["hp"] = 0
        await _defeat(call, state, log); return
    state["last_log"] = "\n".join(log)
    await safe_edit(call, battle_text(state), battle_kb(p))

@router.callback_query(F.data.startswith("battle:skill:"))
async def battle_skill(call: CallbackQuery):
    state = ACTIVE_BATTLES.get(call.from_user.id)
    if not state: await call.answer("Бой не найден"); return
    idx = int(call.data.split(":")[2])
    p, m = state["player"], state["mob"]
    skills = get_class_skills(p["class_id"], p["level"])
    if idx >= len(skills):
        await call.answer("Скилл не открыт"); return
    sk = skills[idx]
    if p["mp"] < sk["mp_cost"]:
        await call.answer("Не хватает MP", show_alert=True); return
    p["mp"] -= sk["mp_cost"]
    log = [f"{sk['emoji']} <b>{sk['name']}</b>!"]
    crit = random.random() * 100 < (p["crit"] + sk.get("crit_bonus", 0))
    dmg = int(max(1, p["atk"] - m["def"] // 2 + random.randint(0, 4)) * sk["mult"])
    if crit: dmg *= 2
    m["hp"] -= dmg
    log.append(f"⚔️ Нанесено <b>{dmg}</b>" + (" 💥 <b>КРИТ!</b>" if crit else ""))
    if sk.get("lifesteal"):
        heal = int(dmg * sk["lifesteal"])
        p["hp"] = min(p["max_hp"], p["hp"] + heal)
        log.append(f"🩸 +{heal} HP")
    if sk.get("heal_pct"):
        heal = int(p["max_hp"] * sk["heal_pct"])
        p["hp"] = min(p["max_hp"], p["hp"] + heal)
        log.append(f"💚 +{heal} HP")
    if m["hp"] <= 0:
        m["hp"] = 0
        await _victory(call, state, log); return
    await _mob_turn(state, log)
    if p["hp"] <= 0:
        p["hp"] = 0
        await _defeat(call, state, log); return
    state["last_log"] = "\n".join(log)
    await safe_edit(call, battle_text(state), battle_kb(p))

async def _roll_drops(drops):
    """Возвращает список выпавших item_id."""
    out = []
    if not drops: return out
    for iid, chance in drops:
        if random.random() < chance:
            out.append(iid)
    return out

async def _victory(call, state, log):
    p, m = state["player"], state["mob"]
    xp = m["xp"]
    gr = m.get("gold_range", (5, 15))
    gold = random.randint(gr[0], gr[1])
    p["xp"] += xp; p["gold"] += gold
    levels = check_level_up(p)
    dropped = await _roll_drops(m.get("drops"))
    for iid in dropped:
        await add_inventory(call.from_user.id, iid, 1)
    b_hp = p.get("_base_max_hp", p["max_hp"])
    b_mp = p.get("_base_max_mp", p["max_mp"])
    b_atk = p.get("_base_atk", p["atk"])
    b_def = p.get("_base_def", p["def"])
    b_spd = p.get("_base_spd", p["spd"])
    b_crit = p.get("_base_crit", p["crit"])
    await db.execute(
        "UPDATE players SET level=?, xp=?, hp=?, max_hp=?, mp=?, max_mp=?, "
        "atk=?, def=?, spd=?, crit=?, gold=?, stat_points=? WHERE user_id=?",
        (p["level"], p["xp"], min(p["hp"], b_hp), b_hp, min(p["mp"], b_mp), b_mp,
         b_atk, b_def, b_spd, b_crit, p["gold"], p.get("stat_points", 0),
         call.from_user.id))
    ACTIVE_BATTLES.pop(call.from_user.id, None)
    is_boss = m.get("is_boss", False)
    header = "👑 <b>БОСС ПОВЕРЖЕН!</b>" if is_boss else "🏆 <b>Победа!</b>"
    log.append(f"\n{header}")
    log.append(f"💰 +{gold} золота")
    log.append(f"✨ +{xp} XP")
    if levels:
        log.append(f"🎉 <b>Уровень {p['level']}! +{levels*STAT_POINTS_PER_LEVEL} очков</b>")
    if dropped:
        log.append("\n🎁 <b>Дроп:</b>")
        for iid in dropped:
            it = ITEMS.get(iid, {})
            rar = RARITIES[it.get("rarity","common")]["emoji"]
            log.append(f"· {rar} {it.get('emoji','📦')} {it.get('name', iid)}")
    await safe_edit(call, "⚔️ <b>Бой окончен</b>\n\n" + "\n".join(log), back_to_main())

async def _defeat(call, state, log):
    p = state["player"]
    xp_lost = int(p["xp"] * 0.1)
    p["xp"] = max(0, p["xp"] - xp_lost)
    b_hp = p.get("_base_max_hp", p["max_hp"])
    b_mp = p.get("_base_max_mp", p["max_mp"])
    respawn = nearest_city(p["location_id"])
    await db.execute(
        "UPDATE players SET xp=?, hp=?, mp=?, location_id=? WHERE user_id=?",
        (p["xp"], b_hp // 2, b_mp // 2, respawn, call.from_user.id))
    ACTIVE_BATTLES.pop(call.from_user.id, None)
    log.append("\n💀 <b>Ты погиб...</b>")
    log.append(f"✨ -{xp_lost} XP")
    log.append(f"🏰 Возрождён в {LOCATIONS[respawn]['name']}")
    await safe_edit(call, "⚔️ <b>Бой окончен</b>\n\n" + "\n".join(log), back_to_main())

@router.callback_query(F.data == "battle:flee")
async def battle_flee(call: CallbackQuery):
    state = ACTIVE_BATTLES.get(call.from_user.id)
    if not state: return
    p = state["player"]
    if random.random() < 0.5:
        ACTIVE_BATTLES.pop(call.from_user.id, None)
        await safe_edit(call, "🏃 <b>Ты сбежал!</b>", back_to_main()); return
    log = ["❌ Побег не удался!"]
    await _mob_turn(state, log)
    if p["hp"] <= 0:
        p["hp"] = 0
        await _defeat(call, state, log); return
    state["last_log"] = "\n".join(log)
    await safe_edit(call, battle_text(state), battle_kb(p))

# ══════════════════════════════════════════════════════════════
#  PvP (сокращён — аналогично предыдущей версии)
# ══════════════════════════════════════════════════════════════
@router.callback_query(F.data.startswith("pvp:raid:"))
async def pvp_raid(call: CallbackQuery):
    tid = int(call.data.split(":")[2]); aid = call.from_user.id
    if tid == aid: await call.answer("На себя нельзя"); return
    p1 = await get_player(aid); p2 = await get_player(tid)
    if not p1 or not p2: await call.answer("Не найден"); return
    if p1["location_id"] != p2["location_id"]:
        await call.answer("Не на этой локации", show_alert=True); return
    if LOCATIONS[p1["location_id"]]["safe"]:
        await call.answer("В городе нельзя", show_alert=True); return
    if (aid in ACTIVE_BATTLES or aid in USER_PVP_KEY or aid in USER_PARTY_BATTLE):
        await call.answer("Ты в бою", show_alert=True); return
    if (tid in ACTIVE_BATTLES or tid in USER_PVP_KEY or tid in USER_PARTY_BATTLE):
        await call.answer("Игрок в бою", show_alert=True); return
    p1e = apply_equipment_to_player_copy(p1)
    p2e = apply_equipment_to_player_copy(p2)
    keys = ("user_id","nickname","class_id","level","hp","max_hp","mp","max_mp",
            "atk","def","spd","crit")
    p1s = {k: p1e[k] for k in keys}; p2s = {k: p2e[k] for k in keys}
    if p1s["spd"] > p2s["spd"]: turn_id = aid
    elif p2s["spd"] > p1s["spd"]: turn_id = tid
    else: turn_id = random.choice([aid, tid])
    key = pvp_key(aid, tid)
    battle = {"key": key, "p1": p1s, "p2": p2s, "turn_id": turn_id,
              "log": f"⚔️ <b>{p1s['nickname']}</b> напал на <b>{p2s['nickname']}</b>!"}
    ACTIVE_PVP[key] = battle
    USER_PVP_KEY[aid] = key; USER_PVP_KEY[tid] = key
    try:
        await call.bot.send_message(tid, render_pvp(battle),
            reply_markup=pvp_kb(turn_id, tid, p2s["class_id"], p2s["level"]),
            parse_mode="HTML")
    except:
        ACTIVE_PVP.pop(key, None); USER_PVP_KEY.pop(aid, None)
        USER_PVP_KEY.pop(tid, None)
        await call.answer("Нужна личка с ботом", show_alert=True); return
    try:
        await call.bot.send_message(aid, render_pvp(battle),
            reply_markup=pvp_kb(turn_id, aid, p1s["class_id"], p1s["level"]),
            parse_mode="HTML")
    except: pass
    try: await call.message.delete()
    except: pass
    await call.answer("⚔️ Бой начался!")

@router.callback_query(F.data == "pvp:attack")
async def pvp_attack(call: CallbackQuery):
    key = USER_PVP_KEY.get(call.from_user.id)
    battle = ACTIVE_PVP.get(key) if key else None
    if not battle: await call.answer("Нет боя"); return
    if battle["turn_id"] != call.from_user.id:
        await call.answer("Не твой ход", show_alert=True); return
    atk, dfn = pvp_pair(battle, call.from_user.id)
    crit = random.random() * 100 < atk["crit"]
    dmg = max(1, atk["atk"] - dfn["def"] // 2 + random.randint(-2, 4))
    if crit: dmg *= 2
    dfn["hp"] -= dmg
    battle["log"] = f"⚔️ <b>{atk['nickname']}</b> наносит <b>{dmg}</b>" + \
                    (" 💥 КРИТ!" if crit else "")
    if dfn["hp"] <= 0:
        dfn["hp"] = 0
        await _pvp_finish(call.bot, battle, winner=atk, loser=dfn); return
    battle["turn_id"] = dfn["user_id"]
    battle["log"] += f"\n\n🎯 Ход <b>{dfn['nickname']}</b>"
    await push_pvp(call.bot, battle); await call.answer()

@router.callback_query(F.data.startswith("pvp:skill:"))
async def pvp_skill(call: CallbackQuery):
    key = USER_PVP_KEY.get(call.from_user.id)
    battle = ACTIVE_PVP.get(key) if key else None
    if not battle: await call.answer("Нет боя"); return
    if battle["turn_id"] != call.from_user.id:
        await call.answer("Не твой ход", show_alert=True); return
    idx = int(call.data.split(":")[2])
    atk, dfn = pvp_pair(battle, call.from_user.id)
    skills = get_class_skills(atk["class_id"], atk["level"])
    if idx >= len(skills): await call.answer("Скилл закрыт"); return
    sk = skills[idx]
    if atk["mp"] < sk["mp_cost"]:
        await call.answer("Нет MP", show_alert=True); return
    atk["mp"] -= sk["mp_cost"]
    crit = random.random() * 100 < (atk["crit"] + sk.get("crit_bonus", 0))
    dmg = int(max(1, atk["atk"] - dfn["def"] // 2 + random.randint(0, 4)) * sk["mult"])
    if crit: dmg *= 2
    dfn["hp"] -= dmg
    log = f"{sk['emoji']} <b>{atk['nickname']}</b> использует <b>{sk['name']}</b>!\n"
    log += f"<b>{dmg}</b> урона" + (" 💥" if crit else "")
    if sk.get("lifesteal"):
        heal = int(dmg * sk["lifesteal"])
        atk["hp"] = min(atk["max_hp"], atk["hp"] + heal); log += f"\n🩸 +{heal}"
    if sk.get("heal_pct"):
        heal = int(atk["max_hp"] * sk["heal_pct"])
        atk["hp"] = min(atk["max_hp"], atk["hp"] + heal); log += f"\n💚 +{heal}"
    if dfn["hp"] <= 0:
        dfn["hp"] = 0; battle["log"] = log
        await _pvp_finish(call.bot, battle, winner=atk, loser=dfn); return
    battle["turn_id"] = dfn["user_id"]
    battle["log"] = log + f"\n\n🎯 Ход <b>{dfn['nickname']}</b>"
    await push_pvp(call.bot, battle); await call.answer()

@router.callback_query(F.data == "pvp:flee")
async def pvp_flee(call: CallbackQuery):
    key = USER_PVP_KEY.get(call.from_user.id)
    battle = ACTIVE_PVP.get(key) if key else None
    if not battle: await call.answer("Нет боя"); return
    me, opp = pvp_pair(battle, call.from_user.id)
    await call.answer("Сдался")
    await _pvp_finish(call.bot, battle, winner=opp, loser=me, surrender=True)

async def _pvp_finish(bot, battle, winner, loser, surrender=False):
    key = battle["key"]
    ACTIVE_PVP.pop(key, None)
    USER_PVP_KEY.pop(battle["p1"]["user_id"], None)
    USER_PVP_KEY.pop(battle["p2"]["user_id"], None)
    w_real = await get_player(winner["user_id"])
    l_real = await get_player(loser["user_id"])
    if not w_real or not l_real: return
    xp_gain = xp_from_pvp(loser["level"])
    xp_loss = int(l_real["xp"] * 0.1)
    w_new = dict(w_real); w_new["xp"] += xp_gain
    w_new["stat_points"] = w_new.get("stat_points", 0)
    levels = check_level_up(w_new)
    await db.execute(
        "UPDATE players SET level=?, xp=?, hp=?, mp=?, stat_points=? WHERE user_id=?",
        (w_new["level"], w_new["xp"], min(winner["hp"], w_new["max_hp"]),
         min(winner["mp"], w_new["max_mp"]), w_new["stat_points"], winner["user_id"]))
    await db.execute(
        "UPDATE players SET xp=?, hp=?, mp=? WHERE user_id=?",
        (max(0, l_real["xp"] - xp_loss), l_real["max_hp"] // 2,
         l_real["max_mp"] // 2, loser["user_id"]))
    msg_win = (f"🏆 <b>Победа в PvP!</b>\n\n"
               f"{'Противник сдался. ' if surrender else ''}"
               f"Ты победил <b>{loser['nickname']}</b>!\n✨ +{xp_gain} XP")
    if levels: msg_win += f"\n🎉 <b>Уровень {w_new['level']}!</b>"
    msg_lose = (f"💀 <b>Поражение в PvP</b>\n\n<b>{winner['nickname']}</b> победил.\n"
                f"✨ -{xp_loss} XP")
    for uid, msg in [(winner["user_id"], msg_win), (loser["user_id"], msg_lose)]:
        try:
            await bot.send_message(uid, msg, parse_mode="HTML", reply_markup=back_to_main())
        except: pass

# ══════════════════════════════════════════════════════════════
#  ПАТИ-БОИ — с детальными наградами
# ══════════════════════════════════════════════════════════════
def render_party_battle(battle):
    mob = battle["mob"]; members = battle["members"]
    prefix = "💀 <b>БОСС</b>\n" if mob.get("is_boss") else ""
    text = (f"{prefix}⚔️ <b>Групповой бой</b> · Раунд {battle['round']}\n\n"
            f"👹 <b>{mob['emoji']} {m['name']}</b> (ур. {mob['level']})\n"
            f"❤️ {hp_bar(mob['hp'], mob['max_hp'])} {mob['hp']}/{mob['max_hp']}\n\n"
            f"<b>Отряд:</b>\n")
    for i, m in enumerate(members):
        c = CLASSES[m["class_id"]]
        if not m["alive"]:
            text += f"💀 {c['emoji']} <b>{m['nickname']}</b> — пал\n"
        else:
            mark = "🎯 " if i == battle["turn_idx"] else ""
            text += (f"{mark}{c['emoji']} <b>{m['nickname']}</b> "
                     f"❤️ {hp_bar(m['hp'], m['max_hp'])} {m['hp']}/{m['max_hp']}\n")
    if battle.get("log"): text += f"\n{battle['log']}"
    return text

def party_battle_kb(battle, my_id):
    me = next((m for m in battle["members"] if m["user_id"] == my_id), None)
    if not me or not me["alive"]:
        return InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="👁 Наблюдать", callback_data="pbattle:noop")]])
    cur = battle["members"][battle["turn_idx"]]
    if cur["user_id"] != my_id:
        return InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text=f"⏳ Ход {cur['nickname']}",
                                  callback_data="pbattle:noop")],
            [InlineKeyboardButton(text="🏃 Сдаться", callback_data="pbattle:leave")]])
    rows = [[InlineKeyboardButton(text="⚔️ Атака", callback_data="pbattle:attack")]]
    for i, sk in enumerate(get_class_skills(me["class_id"], me["level"])):
        rows.append([InlineKeyboardButton(
            text=f"{sk['emoji']} {sk['name']} ({sk['mp_cost']} MP)",
            callback_data=f"pbattle:skill:{i}")])
    rows.append([InlineKeyboardButton(text="🏃 Сдаться", callback_data="pbattle:leave")])
    return InlineKeyboardMarkup(inline_keyboard=rows)

async def push_party_battle(bot, battle):
    text = render_party_battle(battle)
    for m in battle["members"]:
        if m["user_id"] not in USER_PARTY_BATTLE: continue
        kb = party_battle_kb(battle, m["user_id"])
        try: await bot.send_message(m["user_id"], text, reply_markup=kb, parse_mode="HTML")
        except: pass

async def _party_mob_attack(bot, battle):
    mob = battle["mob"]; logs = []
    n = len([m for m in battle["members"] if m["alive"]])
    for _ in range(n):
        alive = [m for m in battle["members"] if m["alive"]]
        if not alive: break
        t = random.choice(alive)
        crit = random.random() * 100 < 5
        dmg = max(1, mob["atk"] - t["def"] // 2 + random.randint(-2, 3))
        if crit: dmg *= 2
        t["hp"] -= dmg
        logs.append(f"👹 бьёт <b>{t['nickname']}</b>: <b>{dmg}</b>" + (" 💥" if crit else ""))
        if t["hp"] <= 0:
            t["hp"] = 0; t["alive"] = False
            logs.append(f"💀 <b>{t['nickname']}</b> пал")
    battle["log"] = " | ".join(logs)

async def _party_advance_turn(bot, battle):
    members = battle["members"]; n = len(members)
    for _ in range(n * 2):
        battle["turn_idx"] = (battle["turn_idx"] + 1) % n
        if battle["turn_idx"] == 0:
            battle["round"] += 1
            await _party_mob_attack(bot, battle)
            if not any(m["alive"] for m in members):
                await _party_defeat(bot, battle); return
        if members[battle["turn_idx"]]["alive"]: break
    await push_party_battle(bot, battle)

async def _party_victory(bot, battle):
    pid = battle["party_id"]
    ACTIVE_PARTY_BATTLES.pop(pid, None)
    mob = battle["mob"]
    survivors = [m for m in battle["members"] if m["alive"]]
    n = max(1, len(survivors))
    xp_each = max(1, mob.get("xp", mob.get("xp_total", 50)) // n if mob.get("is_boss")
                  else mob.get("xp_total", 50) // n)
    gr = mob.get("gold_range", (5, 15))
    gold_each = random.randint(gr[0], gr[1]) if mob.get("is_boss") else max(5, mob["level"] * 15)

    # Roll drops: каждый выпавший предмет достаётся случайному выжившему
    drops = []
    if mob.get("drops"):
        for iid, chance in mob["drops"]:
            if random.random() < chance and survivors:
                winner = random.choice(survivors)
                drops.append((iid, winner["user_id"]))

    # Обработка каждого участника
    results = []
    for m in battle["members"]:
        USER_PARTY_BATTLE.pop(m["user_id"], None)
        real = await get_player(m["user_id"])
        if not real: continue
        if not m["alive"]:
            xp_lost = int(real["xp"] * 0.1)
            respawn = nearest_city(real["location_id"])
            await db.execute(
                "UPDATE players SET xp=?, hp=?, mp=?, location_id=? WHERE user_id=?",
                (max(0, real["xp"] - xp_lost), real["max_hp"] // 2,
                 real["max_mp"] // 2, respawn, m["user_id"]))
            results.append({"user_id": m["user_id"], "nickname": m["nickname"],
                            "dead": True, "xp": -xp_lost, "gold": 0,
                            "items": [], "levels": 0})
            continue
        real["xp"] += xp_each
        real["gold"] += gold_each
        real["stat_points"] = real.get("stat_points", 0)
        levels = check_level_up(real)
        # Получение предметов
        my_items = [iid for iid, uid in drops if uid == m["user_id"]]
        for iid in my_items:
            await add_inventory(m["user_id"], iid, 1)
        await db.execute(
            "UPDATE players SET level=?, xp=?, hp=?, max_hp=?, mp=?, max_mp=?, "
            "atk=?, def=?, spd=?, crit=?, gold=?, stat_points=? WHERE user_id=?",
            (real["level"], real["xp"], min(m["hp"], real["max_hp"]), real["max_hp"],
             min(m["mp"], real["max_mp"]), real["max_mp"], real["atk"], real["def"],
             real["spd"], real["crit"], real["gold"], real["stat_points"],
             m["user_id"]))
        results.append({"user_id": m["user_id"], "nickname": m["nickname"],
                        "dead": False, "xp": xp_each, "gold": gold_each,
                        "items": my_items, "levels": levels})

    # Сводка
    boss_prefix = "👑 <b>БОСС ПОВЕРЖЕН!</b>" if mob.get("is_boss") else "🏆 <b>ПОБЕДА ОТРЯДА!</b>"
    summary = (f"{boss_prefix}\n"
               f"👹 <b>{mob['emoji']} {m['name']}</b> (ур. {mob['level']}) повержен\n\n"
               f"📋 <b>Награды участникам:</b>\n")
    for r in results:
        if r["dead"]:
            summary += f"💀 {r['nickname']} — пал в бою ({r['xp']} XP)\n"
        else:
            line = f"· <b>{r['nickname']}</b> — {r['xp']} XP, {r['gold']}💰"
            if r.get("levels"):
                line += f", 🎉 ур. {r.get('levels')*STAT_POINTS_PER_LEVEL} очков"
            summary += line + "\n"

    if drops:
        summary += "\n🎁 <b>Выпавший лут:</b>\n"
        for iid, uid in drops:
            owner = next((r["nickname"] for r in results if r["user_id"] == uid), "?")
            it = ITEMS.get(iid, {})
            rar = RARITIES[it.get("rarity", "common")]["emoji"]
            summary += f"· {rar} {it.get('emoji','📦')} {it.get('name', iid)} → <b>{owner}</b>\n"
    else:
        summary += "\n<i>Лут не выпал.</i>"

    for r in results:
        try:
            await bot.send_message(r["user_id"], summary, parse_mode="HTML",
                                    reply_markup=back_to_main())
        except: pass

async def _party_defeat(bot, battle):
    pid = battle["party_id"]
    ACTIVE_PARTY_BATTLES.pop(pid, None)
    mob = battle["mob"]
    summary = (f"💀 <b>Отряд разбит!</b>\n"
               f"👹 <b>{mob['emoji']} {m['name']}</b> победил\n\n"
               f"📋 <b>Потери:</b>\n")
    for m in battle["members"]:
        USER_PARTY_BATTLE.pop(m["user_id"], None)
        real = await get_player(m["user_id"])
        if not real: continue
        xp_lost = int(real["xp"] * 0.1)
        respawn = nearest_city(real["location_id"])
        await db.execute(
            "UPDATE players SET xp=?, hp=?, mp=?, location_id=? WHERE user_id=?",
            (max(0, real["xp"] - xp_lost), real["max_hp"] // 2,
             real["max_mp"] // 2, respawn, m["user_id"]))
        summary += f"💀 {m['nickname']} — {xp_lost} XP\n"
    for m in battle["members"]:
        try:
            await bot.send_message(m["user_id"], summary, parse_mode="HTML",
                                    reply_markup=back_to_main())
        except: pass

@router.callback_query(F.data == "party:battle")
async def party_battle_start(call: CallbackQuery):
    me = await get_player(call.from_user.id)
    if not me: await call.answer("Сначала /start", show_alert=True); return
    member = await db.fetchone("SELECT * FROM party_members WHERE user_id = ?",
                                (call.from_user.id,))
    if not member: await call.answer("Ты не в пати"); return
    pid = member["party_id"]
    if pid in ACTIVE_PARTY_BATTLES:
        await call.answer("Бой идёт", show_alert=True); return
    if (call.from_user.id in USER_PARTY_BATTLE or call.from_user.id in ACTIVE_BATTLES
            or call.from_user.id in USER_PVP_KEY):
        await call.answer("Ты в бою", show_alert=True); return
    loc = LOCATIONS[me["location_id"]]
    if loc["safe"]:
        await call.answer("В городе бой запрещён", show_alert=True); return
    mobs = get_mobs_for_location(me["location_id"])
    if not mobs: await call.answer("Нет мобов", show_alert=True); return
    raw = await db.fetchall(
        "SELECT p.* FROM party_members pm JOIN players p ON pm.user_id = p.user_id "
        "WHERE pm.party_id = ? AND p.location_id = ?", (pid, me["location_id"]))
    active = [apply_equipment_to_player_copy(m) for m in raw
              if m["user_id"] not in USER_PVP_KEY and m["user_id"] not in ACTIVE_BATTLES
              and m["user_id"] not in USER_PARTY_BATTLE]
    if len(active) < 2:
        await call.answer("Нужно 2+ бойца на локации", show_alert=True); return

    base = mobs[0]; n = len(active)
    if loc["boss"]:
        boss_data = BOSSES[loc["id"]]
        scaled = _scale_mob(boss_data["name"], boss_data["emoji"], boss_data["level"], True)
        mob = {
            "name": scaled["name"], "emoji": scaled["emoji"], "level": scaled["level"],
            "hp": scaled["hp"] * n, "max_hp": scaled["hp"] * n,
            "atk": scaled["atk"], "def": scaled["def"], "spd": scaled["spd"],
            "xp_total": scaled["xp"], "gold_range": scaled["gold_range"],
            "is_boss": True, "drops": _boss_drops(loc["tier"]),
        }
    else:
        mob = {
            "name": base["name"], "emoji": base["emoji"], "level": base["level"],
            "hp": base["max_hp"] * n, "max_hp": base["max_hp"] * n,
            "atk": base["atk"], "def": base["def"], "spd": base["spd"],
            "xp_total": base["xp"] * n, "is_boss": False,
            "gold_range": base.get("gold_range", (5, 15)),
            "drops": base.get("drops", []),
        }
    members = [{"user_id": m["user_id"], "nickname": m["nickname"],
                "class_id": m["class_id"], "level": m["level"],
                "hp": m["hp"], "max_hp": m["max_hp"],
                "mp": m["mp"], "max_mp": m["max_mp"],
                "atk": m["atk"], "def": m["def"], "spd": m["spd"],
                "crit": m["crit"], "alive": True} for m in active]
    members.sort(key=lambda x: -x["spd"])
    battle = {"party_id": pid, "location_id": me["location_id"],
              "mob": mob, "members": members, "turn_idx": 0, "round": 1,
              "log": f"⚔️ Бой начался! Отряд из {n} бойцов."}
    ACTIVE_PARTY_BATTLES[pid] = battle
    for m in members: USER_PARTY_BATTLE[m["user_id"]] = pid
    try: await call.message.delete()
    except: pass
    await push_party_battle(call.bot, battle)
    await call.answer("⚔️ В бой!")

@router.callback_query(F.data == "pbattle:attack")
async def pbattle_attack(call: CallbackQuery):
    pid = USER_PARTY_BATTLE.get(call.from_user.id)
    battle = ACTIVE_PARTY_BATTLES.get(pid) if pid else None
    if not battle: await call.answer("Нет боя"); return
    cur = battle["members"][battle["turn_idx"]]
    if cur["user_id"] != call.from_user.id:
        await call.answer("Не твой ход", show_alert=True); return
    mob = battle["mob"]
    crit = random.random() * 100 < cur["crit"]
    dmg = max(1, cur["atk"] - mob["def"] // 2 + random.randint(-2, 4))
    if crit: dmg *= 2
    mob["hp"] -= dmg
    battle["log"] = f"⚔️ <b>{cur['nickname']}</b> бьёт на <b>{dmg}</b>" + \
                    (" 💥 КРИТ!" if crit else "")
    if mob["hp"] <= 0:
        mob["hp"] = 0
        await _party_victory(call.bot, battle); return
    await _party_advance_turn(call.bot, battle); await call.answer()

@router.callback_query(F.data.startswith("pbattle:skill:"))
async def pbattle_skill(call: CallbackQuery):
    pid = USER_PARTY_BATTLE.get(call.from_user.id)
    battle = ACTIVE_PARTY_BATTLES.get(pid) if pid else None
    if not battle: await call.answer("Нет боя"); return
    cur = battle["members"][battle["turn_idx"]]
    if cur["user_id"] != call.from_user.id:
        await call.answer("Не твой ход", show_alert=True); return
    idx = int(call.data.split(":")[2])
    skills = get_class_skills(cur["class_id"], cur["level"])
    if idx >= len(skills): await call.answer("Скилл закрыт"); return
    sk = skills[idx]
    if cur["mp"] < sk["mp_cost"]:
        await call.answer("Нет MP", show_alert=True); return
    mob = battle["mob"]
    cur["mp"] -= sk["mp_cost"]
    crit = random.random() * 100 < (cur["crit"] + sk.get("crit_bonus", 0))
    dmg = int(max(1, cur["atk"] - mob["def"] // 2 + random.randint(0, 4)) * sk["mult"])
    if crit: dmg *= 2
    mob["hp"] -= dmg
    log = f"{sk['emoji']} <b>{cur['nickname']}</b>: <b>{dmg}</b>" + (" 💥" if crit else "")
    if sk.get("lifesteal"):
        heal = int(dmg * sk["lifesteal"])
        cur["hp"] = min(cur["max_hp"], cur["hp"] + heal); log += f" · 🩸+{heal}"
    if sk.get("heal_pct"):
        heal = int(cur["max_hp"] * sk["heal_pct"])
        cur["hp"] = min(cur["max_hp"], cur["hp"] + heal); log += f" · 💚+{heal}"
    battle["log"] = log
    if mob["hp"] <= 0:
        mob["hp"] = 0
        await _party_victory(call.bot, battle); return
    await _party_advance_turn(call.bot, battle); await call.answer()

@router.callback_query(F.data == "pbattle:leave")
async def pbattle_leave(call: CallbackQuery):
    pid = USER_PARTY_BATTLE.get(call.from_user.id)
    battle = ACTIVE_PARTY_BATTLES.get(pid) if pid else None
    if not battle: await call.answer("Не в бою"); return
    me = next((m for m in battle["members"] if m["user_id"] == call.from_user.id), None)
    if me: me["alive"] = False; me["hp"] = 0
    USER_PARTY_BATTLE.pop(call.from_user.id, None)
    try: await call.message.edit_text("🏃 Ты покинул бой.", reply_markup=back_to_main())
    except: pass
    await call.answer()
    if not any(m["alive"] for m in battle["members"]):
        await _party_defeat(call.bot, battle); return
    if battle["members"][battle["turn_idx"]]["user_id"] == call.from_user.id:
        await _party_advance_turn(call.bot, battle)
    else:
        await push_party_battle(call.bot, battle)

@router.callback_query(F.data == "pbattle:noop")
async def pbattle_noop(call: CallbackQuery):
    await call.answer("Ждём других игроков")

# ══════════════════════════════════════════════════════════════
#  ИНВЕНТАРЬ
# ══════════════════════════════════════════════════════════════
@router.callback_query(F.data == "menu:inventory")
async def show_inventory(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p: await call.answer("Сначала /start", show_alert=True); return
    items = await db.fetchall(
        "SELECT * FROM inventory WHERE user_id = ? AND quantity > 0 ORDER BY item_id",
        (call.from_user.id,))
    current_filter = USER_INV_FILTER.get(call.from_user.id, "all")
    eff = get_effective_stats(p)
    def b(base, tot):
        d = tot - base
        return f" <i>(+{d})</i>" if d > 0 else ""
    eq_lines = []
    for slot, em in (("weapon_id","🗡️"),("armor_id","🥋"),("shield_id","🛡️")):
        iid = p.get(slot)
        if iid and iid in ITEMS:
            i = ITEMS[iid]
            rar = RARITIES[i["rarity"]]["emoji"]
            short = []
            if i.get("atk"): short.append(f"ATK+{i['atk']}")
            if i.get("def"): short.append(f"DEF+{i['def']}")
            if i.get("spd"): short.append(f"SPD+{i['spd']}")
            if i.get("mp"):  short.append(f"MP+{i['mp']}")
            eq_lines.append(f"{em} {rar} {i['name']} ({', '.join(short) if short else '—'})")
        else:
            eq_lines.append(f"{em} —")
    text = (f"🎒 <b>Инвентарь</b>\n\n"
            f"<b>📊 Статы с экипировкой:</b>\n"
            f"⚔️ {eff['atk']}{b(p['atk'], eff['atk'])} · "
            f"🛡️ {eff['def']}{b(p['def'], eff['def'])} · "
            f"💨 {eff['spd']}{b(p['spd'], eff['spd'])}\n"
            f"❤️ {eff['max_hp']} · 💧 {eff['max_mp']}{b(p['max_mp'], eff['max_mp'])}\n\n"
            f"<b>⭐ Экипировано:</b>\n" + "\n".join(eq_lines))
    await safe_edit(call, text, inventory_kb(items, p, current_filter))

@router.callback_query(F.data.startswith("inv:filter:"))
async def inv_change_filter(call: CallbackQuery):
    cat = call.data.split(":", 2)[2]
    if cat not in [f[0] for f in FILTERS]:
        await call.answer("Неверный фильтр"); return
    USER_INV_FILTER[call.from_user.id] = cat
    await show_inventory(call)

@router.callback_query(F.data.startswith("inv:item:"))
async def view_item(call: CallbackQuery):
    iid = call.data.split(":", 2)[2]
    info = ITEMS.get(iid)
    if not info: await call.answer("Неизвестный"); return
    p = await get_player(call.from_user.id)
    eq_slot = None
    for slot in ("weapon_id", "armor_id", "shield_id"):
        if p.get(slot) == iid: eq_slot = slot; break
    inv_row = await db.fetchone(
        "SELECT * FROM inventory WHERE user_id = ? AND item_id = ?",
        (call.from_user.id, iid))
    qty = inv_row["quantity"] if inv_row else 0
    if not eq_slot and qty == 0:
        await call.answer("Не найден"); return
    rar = RARITIES[info["rarity"]]
    text = (f"{rar['emoji']} <b>{info['name']}</b>\n"
            f"<i>{rar['name']}</i>\n\n"
            f"<i>{info.get('desc','')}</i>\n\n"
            f"<b>Характеристики:</b>\n{item_stats_text(iid)}\n\n")
    if eq_slot: text += "⭐ <b>Экипировано</b>\n"
    if qty > 0: text += f"В инвентаре: <b>{qty}</b>\n"
    rows = []
    if eq_slot:
        rows.append([InlineKeyboardButton(text="🚫 Снять",
                                          callback_data=f"inv:unequip:{eq_slot}")])
    if qty > 0:
        if info["type"] in ("weapon", "armor"):
            slot_map = {"weapon": "weapon_id", "armor": "armor_id"}
            rows.append([InlineKeyboardButton(
                text="⚡ Экипировать",
                callback_data=f"inv:equip:{iid}:{slot_map[info['type']]}")])
        elif info["type"] == "consumable":
            rows.append([InlineKeyboardButton(text="🧪 Использовать",
                                              callback_data=f"inv:use:{iid}")])
        rows.append([InlineKeyboardButton(text="🗑 Выбросить",
                                          callback_data=f"inv:drop:{iid}")])
    rows.append([InlineKeyboardButton(text="⬅️ Назад", callback_data="menu:inventory")])
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("inv:unequip:"))
async def unequip_item(call: CallbackQuery):
    slot = call.data.split(":", 2)[2]
    if slot not in ("weapon_id", "armor_id", "shield_id"):
        await call.answer("Ошибка"); return
    p = await get_player(call.from_user.id)
    iid = p.get(slot)
    if not iid: await call.answer("Пусто"); return
    await db.execute(f"UPDATE players SET {slot} = NULL WHERE user_id = ?",
                     (call.from_user.id,))
    await add_inventory(call.from_user.id, iid, 1)
    p = await get_player(call.from_user.id)
    eff = get_effective_stats(p)
    if p["hp"] > eff["max_hp"]:
        await db.execute("UPDATE players SET hp=? WHERE user_id=?",
                         (eff["max_hp"], call.from_user.id))
    if p["mp"] > eff["max_mp"]:
        await db.execute("UPDATE players SET mp=? WHERE user_id=?",
                         (eff["max_mp"], call.from_user.id))
    await call.answer("✅ Снято")
    await show_inventory(call)

@router.callback_query(F.data.startswith("inv:equip:"))
async def equip_item(call: CallbackQuery):
    parts = call.data.split(":")
    iid, slot = parts[2], parts[3]
    if slot not in ("weapon_id", "armor_id", "shield_id"):
        await call.answer("Ошибка"); return
    p = await get_player(call.from_user.id)
    old = p.get(slot)
    inv_row = await db.fetchone(
        "SELECT * FROM inventory WHERE user_id = ? AND item_id = ? AND quantity > 0",
        (call.from_user.id, iid))
    if not inv_row: await call.answer("Нет в инвентаре"); return
    await db.execute(f"UPDATE players SET {slot} = ? WHERE user_id = ?",
                     (iid, call.from_user.id))
    await db.execute(
        "UPDATE inventory SET quantity = quantity - 1 WHERE user_id = ? AND item_id = ?",
        (call.from_user.id, iid))
    await db.execute("DELETE FROM inventory WHERE quantity <= 0")
    if old and old != iid:
        await add_inventory(call.from_user.id, old, 1)
    await call.answer("✅ Экипировано")
    await show_inventory(call)

@router.callback_query(F.data.startswith("inv:use:"))
async def use_item(call: CallbackQuery):
    iid = call.data.split(":", 2)[2]
    info = ITEMS.get(iid, {})
    if info.get("type") != "consumable":
        await call.answer("Нельзя"); return
    p = await get_player(call.from_user.id)
    eff = get_effective_stats(p)
    hp, mp = p["hp"], p["mp"]
    if info.get("heal_hp"): hp = min(eff["max_hp"], hp + info["heal_hp"])
    if info.get("heal_mp"): mp = min(eff["max_mp"], mp + info["heal_mp"])
    await db.execute("UPDATE players SET hp=?, mp=? WHERE user_id=?",
                     (hp, mp, call.from_user.id))
    await db.execute(
        "UPDATE inventory SET quantity = quantity - 1 WHERE user_id = ? AND item_id = ?",
        (call.from_user.id, iid))
    await db.execute("DELETE FROM inventory WHERE quantity <= 0")
    await call.answer(f"✅ {info['name']}")
    await show_inventory(call)

@router.callback_query(F.data.startswith("inv:drop:"))
async def drop_item(call: CallbackQuery):
    iid = call.data.split(":", 2)[2]
    await db.execute(
        "UPDATE inventory SET quantity = quantity - 1 WHERE user_id = ? AND item_id = ?",
        (call.from_user.id, iid))
    await db.execute("DELETE FROM inventory WHERE quantity <= 0")
    await call.answer("🗑 Выброшено")
    await show_inventory(call)

# ══════════════════════════════════════════════════════════════
#  ТРЕЙД
# ══════════════════════════════════════════════════════════════
@router.callback_query(F.data.startswith("trade:start:"))
async def trade_start(call: CallbackQuery):
    tid = int(call.data.split(":")[2])
    if tid == call.from_user.id:
        await call.answer("С собой нельзя"); return
    items = await db.fetchall(
        "SELECT * FROM inventory WHERE user_id = ? AND quantity > 0 ORDER BY item_id",
        (call.from_user.id,))
    if not items:
        await safe_edit(call, "Нет предметов.", back_to_main()); return
    rows = []
    for it in items:
        info = ITEMS.get(it["item_id"], {})
        rar = RARITIES[info.get("rarity","common")]["emoji"]
        rows.append([InlineKeyboardButton(
            text=f"{rar} {info.get('name', it['item_id'])} ×{it['quantity']}",
            callback_data=f"trade:give:{tid}:{it['item_id']}")])
    rows.append([InlineKeyboardButton(text="❌ Отмена", callback_data="menu:players")])
    await safe_edit(call, "🔄 <b>Трейд</b>\n\nЧто предлагаешь?",
                    InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("trade:give:"))
async def trade_give(call: CallbackQuery):
    parts = call.data.split(":")
    tid, give = int(parts[2]), parts[3]
    items = await db.fetchall(
        "SELECT * FROM inventory WHERE user_id = ? AND quantity > 0 ORDER BY item_id",
        (tid,))
    if not items:
        await safe_edit(call, "У партнёра пусто.", back_to_main()); return
    rows = []
    for it in items:
        info = ITEMS.get(it["item_id"], {})
        rar = RARITIES[info.get("rarity","common")]["emoji"]
        rows.append([InlineKeyboardButton(
            text=f"{rar} {info.get('name', it['item_id'])} ×{it['quantity']}",
            callback_data=f"trade:want:{tid}:{give}:{it['item_id']}")])
    rows.append([InlineKeyboardButton(text="❌ Отмена", callback_data="menu:players")])
    await safe_edit(call, "🔄 <b>Трейд</b>\n\nЧто хочешь взамен?",
                    InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("trade:want:"))
async def trade_want(call: CallbackQuery):
    parts = call.data.split(":")
    tid, give, want = int(parts[2]), parts[3], parts[4]
    tkey = f"{call.from_user.id}_{tid}"
    PENDING_TRADES[tkey] = {"from": call.from_user.id, "to": tid,
                            "give": give, "want": want}
    ig, iw = ITEMS.get(give, {}), ITEMS.get(want, {})
    text = (f"🔄 <b>Предложение трейда!</b>\n\nОт: <b>{call.from_user.full_name}</b>\n\n"
            f"Даёт: {ig.get('emoji','')} {ig.get('name','')}\n"
            f"Хочет: {iw.get('emoji','')} {iw.get('name','')}\n\nПринять?")
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Принять",
                              callback_data=f"trade:accept:{call.from_user.id}")],
        [InlineKeyboardButton(text="❌ Отклонить",
                              callback_data=f"trade:decline:{call.from_user.id}")]])
    try:
        await call.bot.send_message(tid, text, reply_markup=kb, parse_mode="HTML")
    except:
        await call.answer("Нужна личка", show_alert=True); return
    await safe_edit(call, "✅ Отправлено. Ждём.", back_to_main())

@router.callback_query(F.data.startswith("trade:accept:"))
async def trade_accept(call: CallbackQuery):
    from_id = int(call.data.split(":")[2])
    tkey = f"{from_id}_{call.from_user.id}"
    trade = PENDING_TRADES.pop(tkey, None)
    if not trade:
        await call.answer("Трейд устарел", show_alert=True); return
    a = await db.fetchone(
        "SELECT * FROM inventory WHERE user_id=? AND item_id=? AND quantity>0",
        (from_id, trade["give"]))
    b = await db.fetchone(
        "SELECT * FROM inventory WHERE user_id=? AND item_id=? AND quantity>0",
        (call.from_user.id, trade["want"]))
    if not a or not b:
        await call.answer("Нет предмета", show_alert=True); return
    await db.execute("UPDATE inventory SET quantity=quantity-1 WHERE user_id=? AND item_id=?",
                     (from_id, trade["give"]))
    await db.execute("UPDATE inventory SET quantity=quantity-1 WHERE user_id=? AND item_id=?",
                     (call.from_user.id, trade["want"]))
    await db.execute("DELETE FROM inventory WHERE quantity <= 0")
    await add_inventory(from_id, trade["want"], 1)
    await add_inventory(call.from_user.id, trade["give"], 1)
    await safe_edit(call, "✅ Трейд завершён!", back_to_main())
    try: await call.bot.send_message(from_id, "✅ Трейд принят!")
    except: pass

@router.callback_query(F.data.startswith("trade:decline:"))
async def trade_decline(call: CallbackQuery):
    from_id = int(call.data.split(":")[2])
    PENDING_TRADES.pop(f"{from_id}_{call.from_user.id}", None)
    await safe_edit(call, "❌ Отклонён.", back_to_main())

# ══════════════════════════════════════════════════════════════
#  ПАТИ
# ══════════════════════════════════════════════════════════════
async def _show_party(call, party_id):
    party = await db.fetchone("SELECT * FROM parties WHERE party_id = ?", (party_id,))
    if not party:
        await safe_edit(call, "Пати не найдено.", back_to_main()); return
    members = await db.fetchall(
        "SELECT p.user_id, p.nickname, p.level, p.class_id, p.location_id "
        "FROM party_members pm JOIN players p ON pm.user_id = p.user_id "
        "WHERE pm.party_id = ?", (party_id,))
    me = await get_player(call.from_user.id)
    text = "👥 <b>Пати</b>\n\n"
    same = 0
    for m in members:
        c = CLASSES[m["class_id"]]
        mk = "👑 " if m["user_id"] == party["leader_id"] else "· "
        text += f"{mk}{c['emoji']} {m['nickname']} · ур. {m['level']}"
        if me and m["location_id"] != me["location_id"]:
            text += " 🌍"
        elif me: same += 1
        text += "\n"
    if me: text += f"\n📍 На этой локации: <b>{same}</b>"
    if party_id in ACTIVE_PARTY_BATTLES:
        text += "\n\n⚔️ <i>Отряд в бою!</i>"
    rows = []
    in_battle = party_id in ACTIVE_PARTY_BATTLES
    can_battle = (me and not in_battle and call.from_user.id not in USER_PARTY_BATTLE
                  and call.from_user.id not in ACTIVE_BATTLES
                  and call.from_user.id not in USER_PVP_KEY
                  and not LOCATIONS[me["location_id"]]["safe"] and same >= 2)
    if can_battle:
        boss_tag = " 💀" if LOCATIONS[me["location_id"]]["boss"] else ""
        rows.append([InlineKeyboardButton(
            text=f"⚔️ В бой отрядом ({same} чел.){boss_tag}",
            callback_data="party:battle")])
    if not in_battle:
        if party["leader_id"] == call.from_user.id:
            rows.append([InlineKeyboardButton(text="🗑 Распустить",
                                              callback_data="party:disband")])
        else:
            rows.append([InlineKeyboardButton(text="🚪 Покинуть",
                                              callback_data="party:leave")])
    rows.append([InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")])
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data == "party:menu")
async def party_menu(call: CallbackQuery):
    member = await db.fetchone("SELECT * FROM party_members WHERE user_id = ?",
                                (call.from_user.id,))
    if member:
        await _show_party(call, member["party_id"]); return
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="➕ Создать пати", callback_data="party:create")],
        [InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")]])
    await safe_edit(call, "👥 <b>Пати</b>\n\nТы не в пати.", kb)

@router.callback_query(F.data == "party:create")
async def party_create(call: CallbackQuery):
    ex = await db.fetchone("SELECT * FROM party_members WHERE user_id = ?",
                            (call.from_user.id,))
    if ex: await call.answer("Уже в пати"); return
    pid = await db.execute("INSERT INTO parties (leader_id) VALUES (?)",
                            (call.from_user.id,))
    await db.execute("INSERT INTO party_members (party_id, user_id) VALUES (?, ?)",
                     (pid, call.from_user.id))
    await _show_party(call, pid)

@router.callback_query(F.data == "party:leave")
async def party_leave(call: CallbackQuery):
    member = await db.fetchone("SELECT * FROM party_members WHERE user_id = ?",
                                (call.from_user.id,))
    if member and member["party_id"] in ACTIVE_PARTY_BATTLES:
        await call.answer("Сначала закончи бой", show_alert=True); return
    await db.execute("DELETE FROM party_members WHERE user_id = ?", (call.from_user.id,))
    await call.answer("Покинул пати")
    await party_menu(call)

@router.callback_query(F.data == "party:disband")
async def party_disband(call: CallbackQuery):
    party = await db.fetchone("SELECT * FROM parties WHERE leader_id = ?",
                               (call.from_user.id,))
    if party and party["party_id"] in ACTIVE_PARTY_BATTLES:
        await call.answer("Сначала закончите бой", show_alert=True); return
    if party:
        await db.execute("DELETE FROM party_members WHERE party_id = ?",
                         (party["party_id"],))
        await db.execute("DELETE FROM parties WHERE party_id = ?", (party["party_id"],))
    await call.answer("Пати распущена")
    await party_menu(call)

@router.callback_query(F.data.startswith("party:invite:"))
async def party_invite(call: CallbackQuery):
    tid = int(call.data.split(":")[2])
    member = await db.fetchone("SELECT * FROM party_members WHERE user_id = ?",
                                (call.from_user.id,))
    if not member:
        await call.answer("Сначала создай пати", show_alert=True); return
    if await db.fetchone("SELECT * FROM party_members WHERE user_id = ?", (tid,)):
        await call.answer("Игрок в пати", show_alert=True); return
    await db.execute("INSERT INTO party_members (party_id, user_id) VALUES (?, ?)",
                     (member["party_id"], tid))
    await call.answer("✅ Приглашён!")
    try:
        await call.bot.send_message(tid,
            "👥 Тебя пригласили в пати! /menu → 💬 Действия → 👥 Пати")
    except: pass

# ══════════════════════════════════════════════════════════════
#  ЗАПУСК
# ══════════════════════════════════════════════════════════════
async def main():
    global BOT_ID
    logging.basicConfig(level=logging.INFO)
    await db.init()
    bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
    me = await bot.me()
    BOT_ID = me.id
    logging.info(f"🤖 Бот @{me.username} (id={BOT_ID})")
    dp = Dispatcher()
    dp.include_router(router)
    logging.info("🚀 New Era RPG запущен")
    try: await dp.start_polling(bot)
    finally: await db.close()


if __name__ == "__main__":
    asyncio.run(main())
