#  МАГАЗИН — классовые предметы, детальный просмотр
# ══════════════════════════════════════════════════════════════
def get_shop_items(player):
    """Возвращает список iid доступных в магазине для игрока."""
    loc = LOCATIONS[player["location_id"]]
    if not loc["safe"]: return []
    shop_tier = loc["tier"] + 1  # city tier 1 → shop tier 2
    cls = player["class_id"]
    result = []
    for iid, info in ITEMS.items():
        itype = info.get("type")
        if itype in ("weapon", "armor"):
            if info.get("class") != cls: continue
            if info.get("tier") != shop_tier: continue
            result.append(iid)
        elif itype == "consumable":
            if info.get("tier", 1) <= shop_tier and info.get("tier", 1) >= shop_tier - 1:
                result.append(iid)
    return result

@router.callback_query(F.data == "shop:open")
async def shop_open(call: CallbackQuery):
    p = await get_player(call.from_user.id)
