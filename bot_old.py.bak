            f"<i>{rar['name']} · {info.get('type','?')}</i>\n\n"
            f"{info.get('desc','')}\n\n"
            f"<b>Характеристики:</b>\n{item_stats_text(iid)}\n\n"
            f"💰 Цена: <b>{info['price']}</b> золота\n"
            f"💼 У тебя: <b>{p['gold']}</b> золота")
    rows = []
    if p["gold"] >= info["price"]:
        rows.append([InlineKeyboardButton(text="✅ Купить",
                                          callback_data=f"shop:buy:{iid}")])
