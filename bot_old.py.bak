#  ПРОФИЛЬ — кнопка "Статы" ВСЕГДА видна
# ══════════════════════════════════════════════════════════════
@router.callback_query(F.data == "menu:profile")
async def show_profile(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p:
        await call.answer("Сначала /start", show_alert=True); return
    c = CLASSES[p["class_id"]]; loc = LOCATIONS[p["location_id"]]
    eff = get_effective_stats(p)
    if p["level"] < MAX_LEVEL:
        need = xp_to_next(p["level"])
        xp_line = f"✨ XP: {hp_bar(p['xp'], need)} {p['xp']}/{need}"
    else:
        xp_line = "✨ <b>МАКСИМАЛЬНЫЙ УРОВЕНЬ</b>"
    def bonus(b, t):
        d = t - b
        return f" <i>(+{d})</i>" if d > 0 else ""
    sp = p.get("stat_points", 0)
    sp_line = (f"\n📊 <b>Очки статов: {sp}</b> ⭐" if sp > 0
               else "\n📊 Очков статов: 0")
    text = (f"🧙 <b>Профиль</b>\n"
            f"╔══════════════════╗\n"
            f"  {c['emoji']} <b>{p['nickname']}</b>\n"
            f"  Класс: {c['name']}\n"
            f"  Уровень: <b>{p['level']}</b> / 100\n"
            f"╚══════════════════╝\n\n"
            f"❤️ HP: {hp_bar(p['hp'], eff['max_hp'])} {p['hp']}/{eff['max_hp']}\n"
            f"💧 MP: {hp_bar(p['mp'], eff['max_mp'])} {p['mp']}/{eff['max_mp']}\n"
            f"{xp_line}\n\n"
            f"⚔️ ATK: {eff['atk']}{bonus(p['atk'], eff['atk'])}\n"
            f"🛡️ DEF: {eff['def']}{bonus(p['def'], eff['def'])}\n"
            f"💨 SPD: {eff['spd']}{bonus(p['spd'], eff['spd'])}\n"
            f"💥 CRIT: {eff['crit']}%\n"
            f"💰 Золото: {p['gold']}{sp_line}\n\n"
            f"📍 {loc['emoji']} {loc['name']}")
    # Кнопка статов ВСЕГДА
    if sp > 0:
        stats_btn = InlineKeyboardButton(text=f"📊 Потратить очки ({sp})",
                                          callback_data="stats:menu")
    else:
        stats_btn = InlineKeyboardButton(text="📊 Статы (0 очков)",
                                          callback_data="stats:menu")
    rows = [
        [stats_btn],
        [InlineKeyboardButton(text="📖 Способности", callback_data="skills:list")],
        [InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")],
    ]
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

