LOCATIONS = {}
for i, data in enumerate(LOCATIONS_DATA):
    x, y = i % 4, i // 4
    zone = (y // 2) + 1
    LOCATIONS[i] = {
        "id": i, "x": x, "y": y, "zone": zone,
        "type": data["type"], "name": data["name"],
        "emoji": TYPE_EMOJI[data["type"]],
        "safe": data["type"] == "city",
        "boss": data.get("boss", False),
        "tier": zone,  # 1-4, для магазина
    }

def neighbors(lid):
    x, y = lid % 4, lid // 4
    r = {}
    if y > 0: r["north"] = (y - 1) * 4 + x
    if y < 7: r["south"] = (y + 1) * 4 + x
    if x > 0: r["west"] = y * 4 + (x - 1)
    if x < 3: r["east"] = y * 4 + (x + 1)
    return r

def nearest_city(lid):
    cities = [i for i, l in LOCATIONS.items() if l["safe"]]
    return min(cities, key=lambda c: abs(c % 4 - lid % 4) + abs(c // 4 - lid // 4))

