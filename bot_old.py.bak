    text = (f"🏪 <b>Магазин — {loc['name']}</b>\n\n"
            f"💰 Твоё золото: <b>{p['gold']}</b>\n\n"
            f"🛒 Покупай снаряжение для класса <b>{CLASSES[p['class_id']]['name']}</b> "
            f"или продавай ненужное.")
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🛒 Купить", callback_data="shop:buy_menu")],
        [InlineKeyboardButton(text="💰 Продать", callback_data="shop:sell_menu")],
        [InlineKeyboardButton(text="⬅️ Назад", callback_data="menu:actions")]])
    await safe_edit(call, text, kb)

@router.callback_query(F.data == "shop:buy_menu")
