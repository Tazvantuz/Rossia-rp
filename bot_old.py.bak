@router.callback_query(F.data == "menu:location")
async def show_location(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p: await call.answer("Сначала /start", show_alert=True); return
    loc = LOCATIONS[p["location_id"]]
    mobs = get_mobs_for_location(p["location_id"])
    players_here = await db.fetchall(
        "SELECT nickname, level FROM players WHERE location_id = ? AND user_id != ?",
        (p["location_id"], call.from_user.id))
    text = (f"{loc['emoji']} <b>{loc['name']}</b>\n"
            f"<i>{ZONE_NAMES[loc['zone']]} · "
            f"{'безопасно' if loc['safe'] else 'PvP'}"
            f"{' · 💀 Логово босса' if loc['boss'] else ''}</i>\n\n")
    if mobs:
        text += "👹 <b>Обитатели:</b>\n"
        for m in mobs:
            prefix = "👑 " if m.get("is_boss") else "· "
            text += (f"{prefix}{m['emoji']} {m['name']} "
                     f"(ур. {m['level']}, HP {m['max_hp']}, DEF {m['def']})\n")
    else:
        text += "🕊️ Тут спокойно.\n"
    if players_here:
        text += f"\n👥 <b>Игроки здесь ({len(players_here)}):</b>\n"
        for ph in players_here[:10]:
            text += f"· {ph['nickname']} (ур. {ph['level']})\n"
    rows = []
    if mobs:
        rows.append([InlineKeyboardButton(
            text="⚔️ Охота" if not loc["boss"] else "💀 Бой с боссом!",
            callback_data="menu:battle")])
    if loc["safe"] and mobs is not None:
        pass
    if loc["safe"]:
        rows.append([InlineKeyboardButton(text="🏪 Магазин", callback_data="shop:open")])
    rows.append([InlineKeyboardButton(text="👥 Игроки", callback_data="menu:players")])
    rows.append([InlineKeyboardButton(text="🗺 Карта", callback_data="menu:map")])
    rows.append([InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")])
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data == "menu:players")
async def show_players(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p: await call.answer("Сначала /start", show_alert=True); return
    loc = LOCATIONS[p["location_id"]]
    players = await db.fetchall(
        "SELECT user_id, nickname, class_id, level FROM players "
        "WHERE location_id = ? AND user_id != ?",
        (p["location_id"], call.from_user.id))
    if not players:
        await safe_edit(call,
            f"👥 На локации <b>{loc['name']}</b> больше никого нет.",
            back_to_main()); return
    rows = []
    for pl in players:
        c = CLASSES[pl["class_id"]]
        rows.append([InlineKeyboardButton(
            text=f"{c['emoji']} {pl['nickname']} · ур. {pl['level']}",
            callback_data=f"players:view:{pl['user_id']}")])
    rows.append([InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")])
    await safe_edit(call, f"👥 <b>Игроки на локации «{loc['name']}»</b>",
                    InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("players:view:"))
async def player_view(call: CallbackQuery):
    target_id = int(call.data.split(":")[2])
    target = await db.fetchone("SELECT * FROM players WHERE user_id = ?", (target_id,))
    me = await get_player(call.from_user.id)
    if not target or not me:
        await call.answer("Игрок не найден"); return
    c = CLASSES[target["class_id"]]
    same_loc = me["location_id"] == target["location_id"]
    can_pvp = (same_loc and not LOCATIONS[me["location_id"]]["safe"]
               and not LOCATIONS[me["location_id"]]["boss"]
               and call.from_user.id not in ACTIVE_BATTLES
               and call.from_user.id not in USER_PVP_KEY
               and call.from_user.id not in USER_PARTY_BATTLE
               and target_id not in ACTIVE_BATTLES
               and target_id not in USER_PVP_KEY
               and target_id not in USER_PARTY_BATTLE)
    if not same_loc:
        await call.answer("Игрок на другой локации", show_alert=True); return
    text = (f"{c['emoji']} <b>{target['nickname']}</b>\n"
            f"Класс: {c['name']}\nУровень: {target['level']}\n"
            f"📍 {LOCATIONS[target['location_id']]['name']}\n\n"
            f"⚔️ ATK {target['atk']} · 🛡️ DEF {target['def']}")
    rows = []
    if can_pvp:
        rows.append([InlineKeyboardButton(text="⚔️ Напасть!",
                                          callback_data=f"pvp:raid:{target_id}")])
    rows.append([InlineKeyboardButton(text="🔄 Трейд",
                                      callback_data=f"trade:start:{target_id}")])
    rows.append([InlineKeyboardButton(text="👥 В пати",
                                      callback_data=f"party:invite:{target_id}")])
    rows.append([InlineKeyboardButton(text="⬅️ Назад", callback_data="menu:players")])
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

# ══════════════════════════════════════════════════════════════
