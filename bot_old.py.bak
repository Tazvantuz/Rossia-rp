        rows.append([InlineKeyboardButton(text="💤 Отдохнуть",
                                          callback_data="action:rest")])
        rows.append([InlineKeyboardButton(text="🏪 Магазин",
                                          callback_data="shop:open")])
    rows.append([InlineKeyboardButton(text="👥 Пати",   callback_data="party:menu")])
    rows.append([InlineKeyboardButton(text="❓ Помощь", callback_data="action:help")])
    rows.append([InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")])
    await safe_edit(call,
        f"💬 <b>Действия</b>\n\n📍 Ты в: {loc['emoji']} <b>{loc['name']}</b>",
        InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data == "action:help")
