@router.callback_query(F.data == "stats:menu")
async def stats_menu(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p:
        await call.answer("Сначала /start", show_alert=True); return
    sp = p.get("stat_points", 0)
    if sp <= 0:
        await call.answer("Нет очков статов. Каждый уровень даёт +3.", show_alert=True); return
    text = (f"📊 <b>Прокачка статов</b>\n\n"
            f"Свободных очков: <b>{sp}</b>\n\n"
            f"⚔️ ATK: {p['atk']}\n"
            f"🛡️ DEF: {p['def']}\n"
            f"💨 SPD: {p['spd']}\n"
            f"❤️ HP: {p['max_hp']}\n"
            f"💧 MP: {p['max_mp']}\n"
            f"💥 CRIT: {p['crit']}%\n\n"
            f"<i>Стоимость: 1 очко за пункт (+5 HP/MP = 1 очко)</i>")
    stats = [("atk","⚔️ +1 ATK"), ("def","🛡️ +1 DEF"), ("spd","💨 +1 SPD"),
             ("hp","❤️ +5 HP"), ("mp","💧 +5 MP"), ("crit","💥 +0.2% CRIT")]
    rows, row = [], []
    for key, label in stats:
        row.append(InlineKeyboardButton(text=label, callback_data=f"stats:add:{key}"))
        if len(row) == 2: rows.append(row); row = []
    if row: rows.append(row)
    rows.append([InlineKeyboardButton(text="⬅️ Назад", callback_data="menu:profile")])
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("stats:add:"))
async def stats_add(call: CallbackQuery):
    key = call.data.split(":")[2]
    p = await get_player(call.from_user.id)
    if not p or p.get("stat_points", 0) <= 0:
        await call.answer("Нет очков", show_alert=True); return
    mapping = {
        "atk":  "atk = atk + 1",
        "def":  "def = def + 1",
        "spd":  "spd = spd + 1",
        "hp":   "max_hp = max_hp + 5, hp = hp + 5",
        "mp":   "max_mp = max_mp + 5, mp = mp + 5",
        "crit": "crit = round(crit + 0.2, 2)",
    }
    if key not in mapping:
        await call.answer("Ошибка"); return
    await db.execute(
        f"UPDATE players SET {mapping[key]}, stat_points = stat_points - 1 "
        f"WHERE user_id = ? AND stat_points >= 1", (call.from_user.id,))
    await call.answer("✅ +1")
    p = await get_player(call.from_user.id)
    if p.get("stat_points", 0) <= 0:
        await safe_edit(call,
            "📊 <b>Прокачка статов</b>\n\n✅ Очки закончились!",
            InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="🧙 К профилю", callback_data="menu:profile")]]))
        return
    await stats_menu(call)

