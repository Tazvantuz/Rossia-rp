@router.callback_query(F.data == "menu:map")
async def show_map(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p: await call.answer("Сначала /start", show_alert=True); return
    await safe_edit(call, render_world_map(p["location_id"]),
                    map_nav_kb(p["location_id"]))

@router.callback_query(F.data.startswith("move:"))
async def do_move(call: CallbackQuery):
    if (call.from_user.id in ACTIVE_BATTLES or call.from_user.id in USER_PVP_KEY
            or call.from_user.id in USER_PARTY_BATTLE):
        await call.answer("Сначала закончи бой!", show_alert=True); return
    new_loc = int(call.data.split(":")[1])
    p = await get_player(call.from_user.id)
    if not p: await call.answer("Сначала /start", show_alert=True); return
    if new_loc not in neighbors(p["location_id"]).values():
        await call.answer("Туда нельзя напрямую"); return
    await db.execute("UPDATE players SET location_id = ? WHERE user_id = ?",
                     (new_loc, call.from_user.id))
    await safe_edit(call, render_world_map(new_loc), map_nav_kb(new_loc))

