def pvp_key(a, b): return f"{min(a,b)}_{max(a,b)}"

def render_pvp(battle):
    p1, p2 = battle["p1"], battle["p2"]
    c1, c2 = CLASSES[p1["class_id"]], CLASSES[p2["class_id"]]
    mk = lambda uid: "🎯 " if battle["turn_id"] == uid else ""
    return (f"⚔️ <b>PvP-бой</b>\n\n"
            f"{mk(p1['user_id'])}{c1['emoji']} <b>{p1['nickname']}</b> (ур. {p1['level']})\n"
            f"❤️ {hp_bar(p1['hp'], p1['max_hp'])} {p1['hp']}/{p1['max_hp']}\n"
            f"💧 {hp_bar(p1['mp'], p1['max_mp'])} {p1['mp']}/{p1['max_mp']}\n\n"
            f"{mk(p2['user_id'])}{c2['emoji']} <b>{p2['nickname']}</b> (ур. {p2['level']})\n"
            f"❤️ {hp_bar(p2['hp'], p2['max_hp'])} {p2['hp']}/{p2['max_hp']}\n"
            f"💧 {hp_bar(p2['mp'], p2['max_mp'])} {p2['mp']}/{p2['max_mp']}\n\n"
            f"{battle.get('log','')}")

def pvp_kb(turn_id, my_id, my_class, my_level):
    my_turn = turn_id == my_id
    rows = [[InlineKeyboardButton(
        text="⚔️ Атака" if my_turn else "⏳ Ход противника", callback_data="pvp:attack")]]
    for i, sk in enumerate(get_class_skills(my_class, my_level)):
        rows.append([InlineKeyboardButton(
            text=f"{sk['emoji']} {sk['name']} ({sk['mp_cost']} MP)",
            callback_data=f"pvp:skill:{i}")])
    rows.append([InlineKeyboardButton(text="🏃 Сдаться", callback_data="pvp:flee")])
    return InlineKeyboardMarkup(inline_keyboard=rows)

async def push_pvp(bot, battle):
    text = render_pvp(battle)
    for player in (battle["p1"], battle["p2"]):
        kb = pvp_kb(battle["turn_id"], player["user_id"], player["class_id"], player["level"])
        try: await bot.send_message(player["user_id"], text, reply_markup=kb, parse_mode="HTML")
        except: pass

def pvp_pair(battle, uid):
    if uid == battle["p1"]["user_id"]: return battle["p1"], battle["p2"]
    return battle["p2"], battle["p1"]

# ══════════════════════════════════════════════════════════════
#  РЕГИСТРАЦИЯ
# ══════════════════════════════════════════════════════════════
@router.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    user = await get_player(message.from_user.id)
    if user:
        await send_to(message, f"👋 С возвращением, <b>{user['nickname']}</b>!",
                      main_menu_kb()); return
    await send_to(message, WELCOME_TEXT, force_reply=(message.chat.type != "private"))
    await state.set_state(Reg.nickname)

@router.message(Command("menu"))
async def cmd_menu(message: Message, state: FSMContext):
    await state.clear()
    user = await get_player(message.from_user.id)
    if not user:
        await send_to(message, "Сначала /start"); return
    await send_to(message, "🏠 <b>Главное меню</b>", main_menu_kb())

@router.message(Reg.nickname)
async def reg_nickname(message: Message, state: FSMContext):
    if message.chat.type != "private":
        rt = message.reply_to_message
        if not rt or not rt.from_user or rt.from_user.id != BOT_ID: return
    nick = (message.text or "").strip()
    if not re.fullmatch(r"[A-Za-zА-Яа-яЁё0-9_]{2,16}", nick):
        await send_to(message, "❌ Ник 2–16 символов: буквы/цифры/_."); return
    if await db.fetchone("SELECT user_id FROM players WHERE nickname = ?", (nick,)):
        await send_to(message, "❌ Ник занят. Другой:"); return
    await state.update_data(nickname=nick)
    await state.set_state(Reg.class_choice)
    await send_to(message, "🎭 Выбери свой класс:", class_list_kb())

@router.callback_query(Reg.class_choice, F.data.startswith("reg:class:"))
async def reg_class_select(call: CallbackQuery, state: FSMContext):
    cid = call.data.split(":")[2]; c = CLASSES[cid]
    await state.update_data(class_id=cid)
    skills = CLASS_SKILLS[cid]
    skills_text = "\n".join(f"• ур. {s['level']} — {s['emoji']} {s['name']}" for s in skills)
    w = ITEMS[c["start_weapon"]]; a = ITEMS[c["start_armor"]]
    text = (f"{c['emoji']} <b>{c['name']}</b>\n\n{c['desc']}\n\n"
            f"❤️ HP: {c['hp']} · 💧 MP: {c['mp']}\n"
            f"⚔️ ATK: {c['atk']} · 🛡️ DEF: {c['def']}\n"
            f"💨 SPD: {c['spd']} · 💥 CRIT: {c['crit']}%\n\n"
            f"✨ <b>Скиллы:</b>\n{skills_text}\n\n"
            f"🗡️ {RARITIES[w['rarity']]['emoji']} {w['name']}\n"
            f"🥋 {RARITIES[a['rarity']]['emoji']} {a['name']}\n")
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Подтвердить", callback_data="reg:confirm")],
        [InlineKeyboardButton(text="⬅️ Назад", callback_data="reg:back")]])
    await safe_edit(call, text, kb)

@router.callback_query(Reg.class_choice, F.data == "reg:back")
async def reg_back(call: CallbackQuery, state: FSMContext):
    await state.set_state(Reg.class_choice)
    await safe_edit(call, "🎭 Выбери свой класс:", class_list_kb())

@router.callback_query(Reg.class_choice, F.data == "reg:confirm")
async def reg_confirm(call: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    nick, cid = data.get("nickname"), data.get("class_id")
    if not nick or not cid:
        await call.answer("Сессия истекла. /start", show_alert=True)
        await state.clear(); return
    c = CLASSES[cid]
    await db.execute(
        """INSERT INTO players
        (user_id, nickname, class_id, level, xp, hp, max_hp, mp, max_mp,
         atk, def, spd, crit, gold, location_id, weapon_id, armor_id,
         shield_id, stat_points)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,NULL,?)""",
        (call.from_user.id, nick, cid, 1, 0, c["hp"], c["hp"], c["mp"], c["mp"],
         c["atk"], c["def"], c["spd"], c["crit"], 100, START_LOCATION,
         c["start_weapon"], c["start_armor"], 0))
    for iid, qty in [("potion_hp_1", 3), ("potion_mp_1", 2)]:
        await add_inventory(call.from_user.id, iid, qty)
    await state.clear()
    await safe_edit(call,
        f"🎉 <b>Добро пожаловать, {nick}!</b>\n\n"
        f"Ты — {c['emoji']} {c['name']} 1 уровня.\n"
        f"Путь начинается в {LOCATIONS[START_LOCATION]['name']}.\n\n"
        f"<i>📊 За каждый уровень — 3 очка статов. Трать в профиле.</i>",
        main_menu_kb())

