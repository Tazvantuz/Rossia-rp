FILTERS = [("all","📦 Всё"),("weapon","⚔️ Оружие"),("armor","🥋 Броня"),
           ("consumable","🧪 Зелья")]

def inventory_kb(items, player, current_filter):
    rows = []
    for slot, _ in (("weapon_id","🗡️"), ("armor_id","🥋"), ("shield_id","🛡️")):
        iid = player.get(slot)
        if iid and iid in ITEMS:
            info = ITEMS[iid]
            rarity = RARITIES[info["rarity"]]["emoji"]
            rows.append([InlineKeyboardButton(
                text=f"⭐ {rarity} {info['emoji']} {info['name']}",
                callback_data=f"inv:item:{iid}")])
    f1, f2 = [], []
    for i, (cat, label) in enumerate(FILTERS):
        btn = InlineKeyboardButton(
            text=("✅ " if cat == current_filter else "") + label,
            callback_data=f"inv:filter:{cat}")
        (f1 if i < 3 else f2).append(btn)
    rows.append(f1)
    if f2: rows.append(f2)
    row = []
    for it in items:
        info = ITEMS.get(it["item_id"], {})
        if current_filter != "all" and info.get("type","") != current_filter: continue
        rar = RARITIES[info.get("rarity", "common")]["emoji"]
        label = f"{rar} {info.get('emoji','📦')} {info.get('name', it['item_id'])[:14]}×{it['quantity']}"
        row.append(InlineKeyboardButton(text=label,
                                        callback_data=f"inv:item:{it['item_id']}"))
        if len(row) == 2: rows.append(row); row = []
    if row: rows.append(row)
    rows.append([InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")])
    return InlineKeyboardMarkup(inline_keyboard=rows)

