def map_nav_kb(loc_id):
    n = neighbors(loc_id); rows = []
    def fmt_dest(did):
        d = LOCATIONS[did]
        suffix = "💀" if d["boss"] else ("🏰" if d["safe"] else "")
        return f"{d['emoji']} {d['name']}{suffix}"
    if "north" in n:
        rows.append([InlineKeyboardButton(
            text=f"⬆️ {fmt_dest(n['north'])}", callback_data=f"move:{n['north']}")])
    mid = []
    if "west" in n:
        mid.append(InlineKeyboardButton(
            text=f"⬅️ {LOCATIONS[n['west']]['name'][:12]}", callback_data=f"move:{n['west']}"))
    if "east" in n:
        mid.append(InlineKeyboardButton(
            text=f"{LOCATIONS[n['east']]['name'][:12]} ➡️", callback_data=f"move:{n['east']}"))
    if mid: rows.append(mid)
    if "south" in n:
        rows.append([InlineKeyboardButton(
            text=f"⬇️ {fmt_dest(n['south'])}", callback_data=f"move:{n['south']}")])
    rows.append([InlineKeyboardButton(text="🔍 Осмотреться", callback_data="menu:location")])
    rows.append([InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")])
    return InlineKeyboardMarkup(inline_keyboard=rows)

