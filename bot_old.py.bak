@router.callback_query(F.data == "menu:main")
async def menu_main(call: CallbackQuery):
    user = await get_player(call.from_user.id)
    if not user:
        await call.answer("Сначала /start", show_alert=True); return
    if call.from_user.id in USER_PARTY_BATTLE:
        await call.answer("Ты в групповом бою!", show_alert=True); return
    await safe_edit(call,
        f"🏠 <b>Главное меню</b>\n\n"
        f"👤 {user['nickname']} · ур. {user['level']} · {CLASSES[user['class_id']]['name']}",
        main_menu_kb())

