    p = await get_player(call.from_user.id)
    items = get_shop_items(p)
    loc = LOCATIONS[p["location_id"]]
    text = (f"🛒 <b>Покупка</b> — {loc['name']}\n\n"
            f"💰 Золото: <b>{p['gold']}</b>\n\n"
            f"<i>Показаны предметы для класса {CLASSES[p['class_id']]['name']}</i>")
    rows = []
    for iid in items:
        info = ITEMS[iid]
        rar = RARITIES[info["rarity"]]["emoji"]
        rows.append([InlineKeyboardButton(
            text=f"{rar} {info['emoji']} {info['name']} — {info['price']}💰",
            callback_data=f"shop:view:{iid}")])
    rows.append([InlineKeyboardButton(text="⬅️ Назад", callback_data="shop:open")])
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("shop:view:"))
async def shop_view_item(call: CallbackQuery):
    iid = call.data.split(":", 2)[2]
    info = ITEMS.get(iid)
