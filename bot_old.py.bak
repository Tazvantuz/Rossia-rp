@router.callback_query(F.data == "skills:list")
async def skills_list(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    if not p:
        await call.answer("Сначала /start", show_alert=True); return
    text = f"📖 <b>Способности {CLASSES[p['class_id']]['name']}</b>\n\n"
    for s in CLASS_SKILLS[p["class_id"]]:
        unlocked = s["level"] <= p["level"]
        icon = "✅" if unlocked else "🔒"
        line = f"{icon} <b>{s['emoji']} {s['name']}</b> (ур. {s['level']}) — {s['mp_cost']} MP"
        extras = []
        if s.get("mult"): extras.append(f"×{s['mult']} урон")
        if s.get("crit_bonus"): extras.append(f"крит +{s['crit_bonus']}%")
        if s.get("lifesteal"): extras.append(f"вампиризм {int(s['lifesteal']*100)}%")
        if s.get("heal_pct"): extras.append(f"лечение {int(s['heal_pct']*100)}%")
        if extras: line += f"\n   <i>{' · '.join(extras)}</i>"
        if not unlocked: line += f"\n   <i>Откроется на {s['level']} ур.</i>"
        text += line + "\n\n"
    await safe_edit(call, text, back_to_main())

