@router.callback_query(F.data == "shop:noop")
async def shop_noop(call: CallbackQuery):
    await call.answer("Недостаточно золота")

@router.callback_query(F.data.startswith("shop:buy:"))
async def shop_buy(call: CallbackQuery):
    iid = call.data.split(":", 2)[2]
    info = ITEMS.get(iid)
    if not info:
        await call.answer("Ошибка"); return
    p = await get_player(call.from_user.id)
    if p["gold"] < info["price"]:
        await call.answer("Недостаточно золота", show_alert=True); return
    await db.execute("UPDATE players SET gold = gold - ? WHERE user_id = ?",
                     (info["price"], call.from_user.id))
    await add_inventory(call.from_user.id, iid, 1)
    await call.answer(f"✅ Куплено: {info['name']}")
    await shop_buy_menu(call)

@router.callback_query(F.data == "shop:sell_menu")
async def shop_sell_menu(call: CallbackQuery):
    p = await get_player(call.from_user.id)
    items = await db.fetchall(
        "SELECT * FROM inventory WHERE user_id = ? AND quantity > 0 ORDER BY item_id",
        (call.from_user.id,))
    text = (f"💰 <b>Продажа</b>\n\n💰 Золото: <b>{p['gold']}</b>\n\n"
            f"<i>Продажа = 35% от цены.</i>")
    rows = []
    for it in items:
        info = ITEMS.get(it["item_id"], {})
        if not info: continue
        sp = item_sell_price(it["item_id"])
        rar = RARITIES[info.get("rarity","common")]["emoji"]
        rows.append([InlineKeyboardButton(
            text=f"{rar} {info.get('emoji','📦')} {info.get('name','?')} ×{it['quantity']} → {sp}💰",
            callback_data=f"shop:sell_confirm:{it['item_id']}")])
    if not items:
        text += "\n\n<i>Нет предметов для продажи.</i>"
    rows.append([InlineKeyboardButton(text="⬅️ Назад", callback_data="shop:open")])
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("shop:sell_confirm:"))
async def shop_sell_confirm(call: CallbackQuery):
    iid = call.data.split(":", 2)[2]
    info = ITEMS.get(iid, {})
    p = await get_player(call.from_user.id)
    sp = item_sell_price(iid)
    rar = RARITIES[info.get("rarity","common")]
    text = (f"💰 <b>Продажа</b>\n\n"
            f"{rar['emoji']} <b>{info.get('name', iid)}</b>\n\n"
            f"💰 Цена: <b>{sp}</b> золота\n"
            f"💼 У тебя: <b>{p['gold']}</b> золота")
    rows = [
        [InlineKeyboardButton(text=f"✅ Продать за {sp}💰",
                              callback_data=f"shop:sell:{iid}")],
        [InlineKeyboardButton(text="❌ Отмена", callback_data="shop:sell_menu")]]
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=rows))

@router.callback_query(F.data.startswith("shop:sell:"))
async def shop_sell(call: CallbackQuery):
    iid = call.data.split(":", 2)[2]
    row = await db.fetchone(
        "SELECT * FROM inventory WHERE user_id = ? AND item_id = ? AND quantity > 0",
        (call.from_user.id, iid))
    if not row:
        await call.answer("Нет предмета"); return
    sp = item_sell_price(iid)
    await db.execute("UPDATE players SET gold = gold + ? WHERE user_id = ?",
                     (sp, call.from_user.id))
    await db.execute(
        "UPDATE inventory SET quantity = quantity - 1 WHERE user_id = ? AND item_id = ?",
        (call.from_user.id, iid))
    await db.execute("DELETE FROM inventory WHERE quantity <= 0")
    await call.answer(f"✅ Продано за {sp}💰")
    await shop_sell_menu(call)

# ══════════════════════════════════════════════════════════════
#  ЛИДЕРБОРД
# ══════════════════════════════════════════════════════════════
async def _render_leaders(call, category):
    if category not in LEADERBOARD: category = "level"
    meta = LEADERBOARD[category]
    rows_db = await db.fetchall(
        f"SELECT nickname, class_id, level, xp, max_hp, max_mp, atk, def, spd, crit, gold "
        f"FROM players ORDER BY {meta['order']}, user_id ASC LIMIT 10")
    text = f"🏆 <b>Лидеры — {meta['title']}</b>\n\n"
    if not rows_db:
        text += "Пока никто не зарегистрирован."
    else:
        medals = ["🥇", "🥈", "🥉"] + ["▫️"] * 7
        for i, r in enumerate(rows_db):
            c = CLASSES[r["class_id"]]
            if category == "level":
                need = xp_to_next(r["level"]) if r["level"] < MAX_LEVEL else 0
                value = f"ур. <b>{r['level']}</b>"
                if need: value += f" · XP {r['xp']}/{need}"
            elif category == "crit": value = f"<b>{r['crit']}%</b>"
            elif category == "hp": value = f"<b>{r['max_hp']}</b> HP"
            elif category == "mp": value = f"<b>{r['max_mp']}</b> MP"
            elif category == "gold": value = f"<b>{r['gold']}</b> 💰"
            else: value = f"<b>{r[category]}</b> {meta['label']}"
            line = f"{medals[i]} {c['emoji']} <b>{r['nickname']}</b> — {value}"
            if category != "level": line += f" <i>(ур. {r['level']})</i>"
            text += line + "\n"
    btns = [InlineKeyboardButton(
        text=("✅ " if cat == category else "") + LEADERBOARD[cat]["title"],
        callback_data=f"leaders:show:{cat}") for cat in LEADERBOARD]
    kb_rows = [btns[i:i+2] for i in range(0, len(btns), 2)]
    kb_rows.append([InlineKeyboardButton(text="🏠 Главное меню", callback_data="menu:main")])
    await safe_edit(call, text, InlineKeyboardMarkup(inline_keyboard=kb_rows))

