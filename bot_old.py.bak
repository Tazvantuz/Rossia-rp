ZONE_NAMES = {
    1: "ЗОНА I · ур. 1-10",
    2: "ЗОНА II · ур. 11-20",
    3: "ЗОНА III · ур. 21-30",
    4: "ЗОНА IV · ур. 31-40",
}

def render_world_map(loc_id):
    cur = LOCATIONS[loc_id]
    lines = ["🗺 <b>КАРТА МИРА</b>", ""]
    for zone in range(1, 5):
        lines.append(f"╔═══ {ZONE_NAMES[zone]} ═══╗")
        lines.append("║                          ║")
        for row_in_zone in range(2):
            y = (zone - 1) * 2 + row_in_zone
            cells = []
            for x in range(4):
                lid = y * 4 + x
                loc = LOCATIONS[lid]
                if lid == loc_id:
                    cell = f"[{loc['emoji']}]"
                elif loc["boss"]:
                    cell = f"{loc['emoji']}💀"
                else:
                    cell = loc["emoji"]
                cells.append(cell)
            # padding
            row = "║   " + "   ".join(cells)
            lines.append(row + "     ║")
        lines.append("║                          ║")
        lines.append("╚══════════════════════════╝")
        lines.append("")
    status = ("🏰 Безопасная зона" if cur["safe"] else
              "💀 Логово босса" if cur["boss"] else "⚔️ PvP-зона")
    lines.append(f"🧍 <b>Ты здесь:</b> {cur['emoji']} {cur['name']}")
    lines.append(f"📍 {ZONE_NAMES[cur['zone']]} · координаты ({cur['x']}, {cur['y']})")
    lines.append(status)
    lines.append("")
    lines.append("<i>💀 — логово босса · [ ] — ты здесь</i>")
    grid = "\n".join(lines)
    return f"<code>{grid}</code>"

