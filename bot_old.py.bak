def build_items():
    items = {}
    for cls, weapons in WEAPON_DATA.items():
        for i, (name, atk, emoji) in enumerate(weapons, 1):
            iid = f"w_{cls}_{i}"
            items[iid] = {"name": name, "type": "weapon", "class": cls, "tier": i,
                          "atk": atk, "rarity": RARITY_BY_TIER[i], "price": PRICE_BY_TIER[i],
                          "emoji": emoji, "desc": f"Оружие {CLASSES[cls]['name']}а, {i}-й ярус."}
    for cls, armors in ARMOR_DATA.items():
        for i, (name, dfn, extras) in enumerate(armors, 1):
            iid = f"a_{cls}_{i}"
            entry = {"name": name, "type": "armor", "class": cls, "tier": i,
                     "def": dfn, "rarity": RARITY_BY_TIER[i], "price": PRICE_BY_TIER[i],
                     "emoji": "🥋", "desc": f"Броня {CLASSES[cls]['name']}а, {i}-й ярус."}
            entry.update(extras)
            items[iid] = entry
    # Зелья
    potions = [
        ("potion_hp_1", "Малое зелье HP",    "heal_hp", 50,   1, 20,  "🧪"),
        ("potion_mp_1", "Малое зелье MP",    "heal_mp", 30,   1, 20,  "🧴"),
        ("potion_hp_2", "Среднее зелье HP",  "heal_hp", 150,  2, 60,  "🧪"),
        ("potion_mp_2", "Среднее зелье MP",  "heal_mp", 80,   2, 60,  "🧴"),
        ("potion_hp_3", "Большое зелье HP",  "heal_hp", 400,  3, 150, "🍷"),
        ("potion_mp_3", "Большое зелье MP",  "heal_mp", 200,  3, 150, "🍶"),
        ("potion_hp_4", "Огромное зелье HP", "heal_hp", 1000, 4, 400, "🍷"),
        ("potion_mp_4", "Огромное зелье MP", "heal_mp", 500,  4, 400, "🍶"),
    ]
    for iid, name, stat, val, tier, price, emoji in potions:
        items[iid] = {"name": name, "type": "consumable", "class": None, "tier": tier,
                      stat: val, "rarity": "common", "price": price, "emoji": emoji,
                      "desc": f"Восстанавливает {val} {'HP' if 'hp' in stat else 'MP'}."}
    return items

ITEMS = build_items()

def item_stats_text(iid):
    info = ITEMS.get(iid, {})
    lines = []
    if info.get("atk"): lines.append(f"⚔️ ATK +{info['atk']}")
    if info.get("def"): lines.append(f"🛡️ DEF +{info['def']}")
    if info.get("spd"): lines.append(f"💨 SPD +{info['spd']}")
    if info.get("mp"):  lines.append(f"💧 MP +{info['mp']}")
    if info.get("hp"):  lines.append(f"❤️ HP +{info['hp']}")
    if info.get("heal_hp"): lines.append(f"❤️ +{info['heal_hp']} HP")
    if info.get("heal_mp"): lines.append(f"💧 +{info['heal_mp']} MP")
    return "\n".join(lines) if lines else "—"

def item_sell_price(iid):
    return max(1, int(ITEMS.get(iid, {}).get("price", 10) * 0.35))

